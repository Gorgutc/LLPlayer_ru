<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared Windows/Linux Avalonia host over FlyleafLib's portable net10.0 TFM.
       The separately shipped WPF app in ../LLPlayer remains supported. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <!-- An explicit publish RID wins over the build host; ordinary dev/test builds use the host payload. -->
    <LLPlayerNativeRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</LLPlayerNativeRuntimeIdentifier>
    <LLPlayerNativeRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</LLPlayerNativeRuntimeIdentifier>
    <LLPlayerNativeRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</LLPlayerNativeRuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LLPlayer.Avalonia</RootNamespace>
    <AssemblyName>LLPlayer.Avalonia</AssemblyName>
    <!-- Keep equal to ../LLPlayer/LLPlayer.csproj <Version> (checked by LLPlayer.Avalonia.Tests). -->
    <Version>0.3.62</Version>
    <Product>LLPlayer</Product>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source + output of Themes/tools/oklch_to_hex.py; the token test reads it next to the test assembly. -->
    <None Include="Themes\tools\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/llplayer.png" />
    <None Include="../LLPlayer/Assets/silero_vad.onnx" Link="Assets/silero_vad.onnx"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Same managed Japanese segmenter and dictionary pins as the supported WPF front-end. -->
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
    <PackageReference Include="LibNMeCab.IpaDicBin" Version="0.10.0" />
    <!-- Avalonia's transitive build-telemetry task (network call on every build): opted out for this repo. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyleafLib\FlyleafLib.csproj" />
    <ProjectReference Include="..\LLPlayer.Core\LLPlayer.Core.csproj" />
  </ItemGroup>

  <!-- The package's build targets copy foreign native payloads for a portable TFM. Keep explicit CPU-only
       allowlists for the selected platform, retaining the layout Whisper.net's loader expects. -->
  <ItemGroup>
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(LLPlayerNativeRuntimeIdentifier)' == 'linux-x64'">
    <None Include="$(PkgWhisper_net_Runtime)/build/linux-x64/libwhisper.so;
                   $(PkgWhisper_net_Runtime)/build/linux-x64/libggml-whisper.so;
                   $(PkgWhisper_net_Runtime)/build/linux-x64/libggml-base-whisper.so;
                   $(PkgWhisper_net_Runtime)/build/linux-x64/libggml-cpu-whisper.so"
          TargetPath="runtimes/linux-x64/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(LLPlayerNativeRuntimeIdentifier)' == 'win-x64'">
    <!-- Same SDK projection pin as WPF; keep this host portable and compile the WinRT adapter only for Windows. -->
    <PackageDownload Include="Microsoft.Windows.SDK.NET.Ref" Version="[10.0.18362.57]" />
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref/10.0.18362.57/lib/net8.0/Microsoft.Windows.SDK.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref/10.0.18362.57/lib/net8.0/WinRT.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Squid-Box.SevenZipSharp.Lite" Version="1.6.2.24" />
    <PackageReference Include="TesseractOCR" Version="5.5.2" ExcludeAssets="build" GeneratePathProperty="true" />
    <None Include="$(PkgTesseractOCR)/x64/leptonica-1.85.0.dll;$(PkgTesseractOCR)/x64/tesseract55.dll"
          TargetPath="runtimes/win-x64/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../LLPlayer/lib/7z.dll" Link="lib/7z.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgWhisper_net_Runtime)/build/win-x64/whisper.dll;
                   $(PkgWhisper_net_Runtime)/build/win-x64/ggml-whisper.dll;
                   $(PkgWhisper_net_Runtime)/build/win-x64/ggml-base-whisper.dll;
                   $(PkgWhisper_net_Runtime)/build/win-x64/ggml-cpu-whisper.dll"
          TargetPath="runtimes/win-x64/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Select just the Windows x64 OpenAL Soft DLL. Exclude automatic assets so cross-publish never copies
         another platform's OpenAL payload or adds a managed OpenAL binding. -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" ExcludeAssets="all" GeneratePathProperty="true" />
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)/runtimes/win-x64/native/soft_oal.dll"
          TargetPath="soft_oal.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition="'$(LLPlayerNativeRuntimeIdentifier)' == 'win-x64'">
    <DefineConstants>$(DefineConstants);LLPLAYER_WINDOWS_OCR</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(LLPlayerNativeRuntimeIdentifier)' != 'win-x64'">
    <Compile Remove="Services/MicrosoftOcrService.Windows.cs;Services/WindowsEngineArchiveExtractor.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LLPlayer.Avalonia.Tests" />
  </ItemGroup>

</Project>
