  <!-- Radius (px): radius = 10, sm = 6, md = 8, lg = 10, xl = 14 -->
  <x:Double x:Key="Shadcn.Radius">10</x:Double>
  <CornerRadius x:Key="Shadcn.RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="Shadcn.RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="Shadcn.RadiusLg">10</CornerRadius>
  <CornerRadius x:Key="Shadcn.RadiusXl">14</CornerRadius>
  <CornerRadius x:Key="Shadcn.RadiusFull">9999</CornerRadius>

  <!-- FluentTheme shape defaults: buttons/inputs use rounded-md, popovers/menus rounded-md, cards rounded-xl -->
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

  <!-- Spacing (Tailwind unit = 4px) -->
  <x:Double x:Key="Shadcn.Space1">4</x:Double>
  <x:Double x:Key="Shadcn.Space2">8</x:Double>
  <x:Double x:Key="Shadcn.Space3">12</x:Double>
  <x:Double x:Key="Shadcn.Space4">16</x:Double>
  <x:Double x:Key="Shadcn.Space6">24</x:Double>
  <x:Double x:Key="Shadcn.Space8">32</x:Double>

  <!-- Control metrics (shadcn v4 button / input sizes) -->
  <x:Double x:Key="Shadcn.ControlHeightSm">32</x:Double>
  <x:Double x:Key="Shadcn.ControlHeight">36</x:Double>
  <x:Double x:Key="Shadcn.ControlHeightLg">40</x:Double>
  <Thickness x:Key="Shadcn.ButtonPaddingSm">12,0</Thickness>
  <Thickness x:Key="Shadcn.ButtonPadding">16,0</Thickness>
  <Thickness x:Key="Shadcn.ButtonPaddingLg">24,0</Thickness>
  <Thickness x:Key="Shadcn.InputPadding">12,4</Thickness>
  <Thickness x:Key="Shadcn.FocusRingThickness">2</Thickness>

  <!-- Typography: Inter (Avalonia.Fonts.Inter), text-xs .. text-2xl -->
  <FontFamily x:Key="Shadcn.FontSans">fonts:Inter#Inter, $Default</FontFamily>
  <x:Double x:Key="Shadcn.TextXs">12</x:Double>
  <x:Double x:Key="Shadcn.TextSm">14</x:Double>
  <x:Double x:Key="Shadcn.TextBase">16</x:Double>
  <x:Double x:Key="Shadcn.TextLg">18</x:Double>
  <x:Double x:Key="Shadcn.TextXl">20</x:Double>
  <x:Double x:Key="Shadcn.Text2xl">24</x:Double>
  <FontWeight x:Key="Shadcn.FontNormal">Normal</FontWeight>
  <FontWeight x:Key="Shadcn.FontMedium">Medium</FontWeight>
  <FontWeight x:Key="Shadcn.FontSemibold">SemiBold</FontWeight>
  <FontWeight x:Key="Shadcn.FontBold">Bold</FontWeight>

  <!-- FluentTheme metric overrides -->
  <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
  <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
  <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
  <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
  <x:Double x:Key="SliderVerticalThumbWidth">16</x:Double>
  <x:Double x:Key="SliderVerticalThumbHeight">16</x:Double>
  <CornerRadius x:Key="SliderThumbCornerRadius">8</CornerRadius>
  <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
  <GridLength x:Key="SliderPreContentMargin">4</GridLength>
  <GridLength x:Key="SliderPostContentMargin">4</GridLength>
  <x:Double x:Key="TextControlThemeMinHeight">36</x:Double>
  <Thickness x:Key="TextControlThemePadding">12,7,12,6</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
  <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePadding">8,6,8,6</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,6,8,6</Thickness>
  <Thickness x:Key="ToolTipBorderThemePadding">12,6</Thickness>
  <x:Double x:Key="ToolTipContentThemeFontSize">12</x:Double>
  <x:Double x:Key="ScrollBarSize">10</x:Double>

</ResourceDictionary>
