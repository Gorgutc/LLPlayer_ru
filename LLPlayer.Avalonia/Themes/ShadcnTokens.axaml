<!--
  "LLPlayer shadcn" design tokens.

  Colours: shadcn/ui (MIT) "neutral" theme, apps/v4/registry/themes.ts @ 98a1fe67b439324ddc857f47fbdce056600a4329,
  converted OKLCH -> sRGB by Themes/tools/oklch_to_hex.py (the regions between BEGIN/END GENERATED are written by that
  script; edit the script, not the region). Key scheme: Shadcn.<Token>Color (Color) and Shadcn.<Token>Brush
  (SolidColorBrush), e.g. Shadcn.MutedForegroundBrush. Dark is LLPlayer's default theme.

  Shape / spacing / typography follow the shadcn v4 defaults: radius = 0.625rem = 10px at 16px/rem, sm/md/lg/xl =
  0.6/0.8/1/1.4 x radius (apps/v4/app/globals.css @theme inline); Tailwind spacing unit 0.25rem = 4px; Inter.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
