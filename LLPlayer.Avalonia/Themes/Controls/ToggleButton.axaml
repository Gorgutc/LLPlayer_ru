<!--
  shadcn/ui Toggle as the default ToggleButton theme: transparent, hover = muted, checked (data-[state=on]) = accent.
  Classes: outline (bordered) ; sizes sm / icon / icon-sm like Button.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shadcn.ForegroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shadcn.RadiusMd}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="{DynamicResource Shadcn.ControlHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource Shadcn.ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Shadcn.TextSm}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_FocusRing"
                  Margin="-3"
                  BorderThickness="{DynamicResource Shadcn.FocusRingThickness}"
                  BorderBrush="Transparent"
                  CornerRadius="{DynamicResource Shadcn.RadiusLg}"
                  IsHitTestVisible="False" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Shadcn.MutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Shadcn.MutedForegroundBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource Shadcn.AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Shadcn.AccentForegroundBrush}" />
    </Style>
    <Style Selector="^.outline">
      <Setter Property="BorderBrush" Value="{DynamicResource Shadcn.InputBrush}" />
    </Style>
    <Style Selector="^.sm">
      <Setter Property="MinHeight" Value="{DynamicResource Shadcn.ControlHeightSm}" />
      <Setter Property="MinWidth" Value="{DynamicResource Shadcn.ControlHeightSm}" />
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="^.icon">
      <Setter Property="Width" Value="{DynamicResource Shadcn.ControlHeight}" />
      <Setter Property="Height" Value="{DynamicResource Shadcn.ControlHeight}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^.icon-sm">
      <Setter Property="Width" Value="{DynamicResource Shadcn.ControlHeightSm}" />
      <Setter Property="Height" Value="{DynamicResource Shadcn.ControlHeightSm}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="BorderBrush" Value="{DynamicResource Shadcn.RingFocusBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
