<!-- shadcn/ui menubar / dropdown-menu / context-menu: popover surface, rounded, accent hover, muted shortcuts. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{DynamicResource Shadcn.TextSm}" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="{DynamicResource Shadcn.TextSm}" />
  </Style>
  <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="{DynamicResource Shadcn.RadiusSm}" />
  </Style>
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="FontSize" Value="{DynamicResource Shadcn.TextXs}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="CornerRadius" Value="{DynamicResource Shadcn.RadiusMd}" />
    <Setter Property="MinWidth" Value="180" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="CornerRadius" Value="{DynamicResource Shadcn.RadiusMd}" />
    <Setter Property="MinWidth" Value="180" />
  </Style>

</Styles>
