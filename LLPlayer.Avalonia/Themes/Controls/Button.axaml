<!--
  shadcn/ui Button (v4) as the default Avalonia Button theme.
  Variants (Classes): default (no class or "default") | secondary | outline | ghost | destructive | link
  Sizes (Classes):    default | sm | lg | icon (+ "icon-sm")
  Focus ring: 2px ring token around the control on keyboard focus (:focus-visible); disabled = 50% opacity.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Shadcn.PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Shadcn.PrimaryForegroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shadcn.RadiusMd}" />
    <Setter Property="Padding" Value="{DynamicResource Shadcn.ButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shadcn.ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Shadcn.TextSm}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_FocusRing"
                  Margin="-3"
                  BorderThickness="{DynamicResource Shadcn.FocusRingThickness}"
                  BorderBrush="Transparent"
                  CornerRadius="{DynamicResource Shadcn.RadiusLg}"
                  IsHitTestVisible="False" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>

    <!-- default (primary) -->
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Shadcn.PrimaryHoverBrush}" />
    </Style>

    <Style Selector="^.secondary">
      <Setter Property="Background" Value="{DynamicResource Shadcn.SecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Shadcn.SecondaryForegroundBrush}" />
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Shadcn.SecondaryHoverBrush}" />
      </Style>
    </Style>

    <Style Selector="^.outline">
      <Setter Property="Background" Value="{DynamicResource Shadcn.InputFillBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shadcn.InputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Shadcn.ForegroundBrush}" />
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Shadcn.InputHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Shadcn.AccentForegroundBrush}" />
      </Style>
    </Style>

    <Style Selector="^.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Shadcn.ForegroundBrush}" />
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Shadcn.GhostHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Shadcn.AccentForegroundBrush}" />
      </Style>
    </Style>

    <Style Selector="^.destructive">
      <Setter Property="Background" Value="{DynamicResource Shadcn.DestructiveFillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Shadcn.DestructiveForegroundBrush}" />
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Shadcn.DestructiveHoverBrush}" />
      </Style>
    </Style>

    <Style Selector="^.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Shadcn.PrimaryBrush}" />
      <Setter Property="Padding" Value="0" />
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.8" />
      </Style>
    </Style>

    <!-- pressed: a touch darker via opacity, like active:scale on the web -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- sizes -->
    <Style Selector="^.sm">
      <Setter Property="MinHeight" Value="{DynamicResource Shadcn.ControlHeightSm}" />
      <Setter Property="Padding" Value="{DynamicResource Shadcn.ButtonPaddingSm}" />
    </Style>
    <Style Selector="^.lg">
      <Setter Property="MinHeight" Value="{DynamicResource Shadcn.ControlHeightLg}" />
      <Setter Property="Padding" Value="{DynamicResource Shadcn.ButtonPaddingLg}" />
    </Style>
    <Style Selector="^.icon">
      <Setter Property="Width" Value="{DynamicResource Shadcn.ControlHeight}" />
      <Setter Property="Height" Value="{DynamicResource Shadcn.ControlHeight}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^.icon-sm">
      <Setter Property="Width" Value="{DynamicResource Shadcn.ControlHeightSm}" />
      <Setter Property="Height" Value="{DynamicResource Shadcn.ControlHeightSm}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="BorderBrush" Value="{DynamicResource Shadcn.RingFocusBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
