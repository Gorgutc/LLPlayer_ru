<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LLPlayer.Avalonia.Controls"
        xmlns:vm="using:LLPlayer.Avalonia.ViewModels" x:Class="LLPlayer.Avalonia.Views.TranslationWindow"
        x:DataType="vm:TranslationViewModel" Classes="dialog" Title="Translation — LLPlayer"
        SizeToContent="Manual" CanResize="True" Width="600" Height="640" MinWidth="400" MinHeight="360">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,16">
      <TextBlock Classes="dialog-title" Text="Translation" />
      <TextBlock Classes="dialog-description" Text="Settings apply only when saved. Provider requests run only from the explicit diagnostic buttons." TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Classes="dialog-footer" Margin="0,16,0,0">
      <Button Content="Close" Classes="outline" Click="OnClose" />
      <Button Name="CancelDiagnosticButton" Content="Cancel request" Classes="outline" IsVisible="{Binding DiagnosticRunning}" Command="{Binding CancelDiagnosticCommand}" />
      <Button Name="SaveButton" Content="Save &amp; Close" IsEnabled="{Binding !Busy}" Command="{Binding SaveCommand}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Name="TranslationMessage" Text="{Binding Message}" TextWrapping="Wrap" Classes="small muted" />
    <TextBlock DockPanel.Dock="Bottom" Name="DiagnosticStatusBlock" Text="{Binding DiagnosticStatus}" TextWrapping="Wrap" Classes="small muted" />
    <ScrollViewer Name="TranslationScroll">
      <StackPanel Spacing="12">
        <TextBlock Name="LoadWarning" Text="{Binding Warning}" TextWrapping="Wrap" Classes="small muted" />
        <StackPanel Name="TranslationFields" Spacing="12" IsEnabled="{Binding !Busy}">
          <TextBlock Text="Word provider" />
          <ComboBox Name="ProviderBox" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" HorizontalAlignment="Stretch" />
          <TextBlock Text="Sentence / subtitle provider (Off by default)" />
          <ComboBox Name="SentenceProviderBox" ItemsSource="{Binding Providers}" SelectedItem="{Binding SentenceProvider}" HorizontalAlignment="Stretch" />
          <TextBlock Text="Edit provider settings (shared by words and subtitles)" TextWrapping="Wrap" />
          <ComboBox Name="EditingProviderBox" ItemsSource="{Binding Providers}" SelectedItem="{Binding EditingProvider}" HorizontalAlignment="Stretch" />
          <TextBlock Classes="small muted" Text="Enable each subtitle slot separately from the Translation menu. Both slots start Off for every session." TextWrapping="Wrap" />
          <TextBlock Text="Dictionary mode (Off by default)" />
          <ComboBox ItemsSource="{Binding DictionaryModes}" SelectedItem="{Binding DictionaryMode}" HorizontalAlignment="Stretch" />
          <TextBlock Text="Target language" />
          <ComboBox Name="TargetBox" ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding TargetLanguage}" HorizontalAlignment="Stretch" />
          <TextBlock Name="TargetAdvisoryBlock" Text="{Binding TargetAdvisory}" Classes="small muted" TextWrapping="Wrap" />
          <HyperlinkButton Content="Provider wiki / setup help" NavigateUri="{Binding ProviderWiki}" />
          <StackPanel Spacing="6" IsVisible="{Binding HasEndpoint}">
            <TextBlock Text="Endpoint" /><TextBox Name="EndpointBox" Text="{Binding Endpoint}" />
            <Button Name="ResetEndpointButton" Content="Reset endpoint only" Classes="outline" Command="{Binding ResetEndpointCommand}" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasModel}">
            <TextBlock Text="{Binding ModelRequirement}" /><TextBox Name="ModelBox" Text="{Binding Model}" />
            <ComboBox Name="AvailableModelsBox" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedAvailableModel}" PlaceholderText="Discovered models (optional selection)" HorizontalAlignment="Stretch" />
            <WrapPanel>
              <Button Name="CheckProviderButton" Content="Check" Classes="outline" Command="{Binding CheckProviderCommand}" Margin="0,0,6,6" />
              <Button Name="GetModelsButton" Content="Get Models" Classes="outline" Command="{Binding GetModelsCommand}" Margin="0,0,6,6" />
              <Button Name="HelloApiButton" Content="Hello API" Classes="outline" Command="{Binding HelloApiCommand}" Margin="0,0,0,6" />
            </WrapPanel>
            <TextBlock Text="Hello API sends a model request using this draft. Check and Get Models request the provider's model list. Saving never sends a diagnostic." TextWrapping="Wrap" Classes="small muted" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasApiKey}">
            <TextBlock Text="API key" /><TextBox Name="ApiKeyBox" Text="{Binding ApiKey}" PasswordChar="●" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasRegion}">
            <TextBlock Text="Azure region (optional)" /><TextBox Text="{Binding Region}" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasChatPath}">
            <TextBlock Text="Chat path" /><TextBox Text="{Binding ChatPath}" />
            <Button Name="ResetChatPathButton" Content="Reset chat path only" Classes="outline" Command="{Binding ResetChatPathCommand}" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasTimeout}">
            <TextBlock Text="Request timeout (ms)" /><NumericUpDown Name="TimeoutBox" Value="{Binding TimeoutMs}" Minimum="1" Maximum="2147483647" FormatString="0" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasModel}">
            <TextBlock Text="Health request timeout (ms)" /><NumericUpDown Value="{Binding HealthTimeoutMs}" Minimum="1" Maximum="2147483647" FormatString="0" />
          </StackPanel>
          <TextBlock Text="Translation parameters" FontWeight="SemiBold" />
          <TextBlock Text="Max translate count backward (0–1000)" />
          <controls:IntegerNumericUpDown Name="TranslateCountBackwardBox" Minimum="0" Maximum="1000" Increment="1" FormatString="0"
                         Text="{Binding TranslateCountBackward, Mode=TwoWay}" AutomationProperties.Name="Max translate count backward" />
          <TextBlock Text="Max translate count forward (0–1000)" />
          <controls:IntegerNumericUpDown Name="TranslateCountForwardBox" Minimum="0" Maximum="1000" Increment="1" FormatString="0"
                         Text="{Binding TranslateCountForward, Mode=TwoWay}" AutomationProperties.Name="Max translate count forward" />
          <TextBlock Text="Max translate concurrency (1–64)" />
          <controls:IntegerNumericUpDown Name="TranslateMaxConcurrencyBox" Minimum="1" Maximum="64" Increment="1" FormatString="0"
                         Text="{Binding TranslateMaxConcurrency, Mode=TwoWay}" AutomationProperties.Name="Max translate concurrency" />
          <Expander Name="ChatExpander" Header="LLM subtitle translation" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10" Margin="0,8,0,0">
              <TextBlock Classes="small muted" Text="Shared chat settings apply to all LLM subtitle providers, independently of the provider editor above. They are retained when using other providers. The OneByOne prompt also applies to LLM word lookups." TextWrapping="Wrap" />
              <TextBlock Text="Translation method" />
              <ComboBox Name="TranslateMethodBox" ItemsSource="{Binding TranslateMethods}" SelectedItem="{Binding TranslateMethod}" HorizontalAlignment="Stretch" />
              <CheckBox Name="IncludeTargetLangRegionBox" Content="Include target language region" IsChecked="{Binding IncludeTargetLangRegion}" />
              <StackPanel Name="ContextWindowFields" Spacing="8" IsVisible="{Binding IsContextWindow}">
                <TextBlock Classes="small muted" Text="Surrounding lines are read-only context. More context can improve accuracy and uses more tokens. 0 disables that side." TextWrapping="Wrap" />
                <TextBlock Text="Context lines before" />
                <TextBox Name="ContextWindowBeforeBox" Text="{Binding ContextWindowBefore}" />
                <TextBlock Text="Context lines after" />
                <TextBox Name="ContextWindowAfterBox" Text="{Binding ContextWindowAfter}" />
                <TextBlock Text="ContextWindow prompt" />
                <TextBlock Classes="small muted" Text="Placeholders: {source_lang}, {target_lang}. The current line and surrounding context are supplied automatically." TextWrapping="Wrap" />
                <TextBox Name="PromptContextWindowBox" Text="{Binding PromptContextWindow}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button Name="ResetContextWindowPromptButton" Content="Reset ContextWindow prompt" Classes="outline" Command="{Binding ResetContextWindowPromptCommand}" />
                <CheckBox Name="GrammarCheckEnabledBox" Content="Grammar / fluency second pass" IsChecked="{Binding GrammarCheckEnabled}" />
                <TextBlock Classes="small muted" Text="When enabled, a separate LLM request checks each translated line. If it fails, the first translation is retained." TextWrapping="Wrap" />
                <StackPanel Name="GrammarPromptFields" Spacing="8" IsVisible="{Binding ShowGrammarPrompt}">
                  <TextBlock Text="Grammar check prompt" />
                  <TextBlock Classes="small muted" Text="Placeholders: {source_lang}, {target_lang}. The source and first translation are supplied automatically." TextWrapping="Wrap" />
                  <TextBox Name="PromptGrammarCheckBox" Text="{Binding PromptGrammarCheck}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                  <Button Name="ResetGrammarCheckPromptButton" Content="Reset grammar check prompt" Classes="outline" Command="{Binding ResetGrammarCheckPromptCommand}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Name="KeepContextFields" Spacing="8" IsVisible="{Binding IsKeepContext}">
                <TextBlock Classes="small muted" Text="Translate sequentially with conversation history. More retained lines use more tokens; 0 retains no previous subtitle pairs." TextWrapping="Wrap" />
                <TextBlock Text="Subtitle context count" />
                <TextBox Name="SubtitleContextCountBox" Text="{Binding SubtitleContextCount}" />
                <TextBlock Text="Context retain policy" />
                <ComboBox Name="ContextRetainPolicyBox" ItemsSource="{Binding ContextRetainPolicies}" SelectedItem="{Binding ContextRetainPolicy}" HorizontalAlignment="Stretch" />
                <TextBlock Classes="small muted" Text="Reset clears history when the count is exceeded; KeepSize removes the oldest pairs." TextWrapping="Wrap" />
                <TextBlock Text="KeepContext prompt" />
                <TextBlock Classes="small muted" Text="Placeholders: {source_lang}, {target_lang}. Subtitle lines are supplied as conversation messages." TextWrapping="Wrap" />
                <TextBox Name="PromptKeepContextBox" Text="{Binding PromptKeepContext}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button Name="ResetKeepContextPromptButton" Content="Reset KeepContext prompt" Classes="outline" Command="{Binding ResetKeepContextPromptCommand}" />
              </StackPanel>
              <StackPanel Name="OneByOneFields" Spacing="8" IsVisible="{Binding IsOneByOne}">
                <TextBlock Text="OneByOne prompt" />
                <TextBlock Classes="small muted" Text="Placeholders: {source_lang}, {target_lang}, {source_text}. Each subtitle line is translated independently. LLM word lookups always use this prompt." TextWrapping="Wrap" />
                <TextBox Name="PromptOneByOneBox" Text="{Binding PromptOneByOne}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button Name="ResetOneByOnePromptButton" Content="Reset OneByOne prompt" Classes="outline" Command="{Binding ResetOneByOnePromptCommand}" />
              </StackPanel>
              <TextBlock Classes="small muted" Text="Context counts must be whole numbers from 0 to 2147483647. Inactive mode values are retained and validated on save." TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
          <Expander Name="SamplingExpander" Header="Advanced LLM parameters" IsVisible="{Binding HasModel}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8" Margin="0,8,0,0">
              <TextBlock Text="Use a dot for decimals. Manual flags control whether sampling values are sent. Token caps are optional; blank leaves the cap unset." Classes="small muted" TextWrapping="Wrap" />
              <CheckBox Name="TemperatureManualBox" Content="Manual temperature (0 to 2)" IsChecked="{Binding TemperatureManual}" />
              <TextBox Name="TemperatureBox" Text="{Binding TemperatureText}" AutomationProperties.Name="Temperature" />
              <CheckBox Name="TopPManualBox" Content="Manual top_p (0 to 1)" IsChecked="{Binding TopPManual}" />
              <TextBox Name="TopPBox" Text="{Binding TopPText}" AutomationProperties.Name="top_p" />
              <CheckBox Name="FrequencyPenaltyManualBox" Content="Manual frequency penalty (-2 to 2)" IsChecked="{Binding FrequencyPenaltyManual}" />
              <TextBox Name="FrequencyPenaltyBox" Text="{Binding FrequencyPenaltyText}" AutomationProperties.Name="Frequency penalty" />
              <CheckBox Name="PresencePenaltyManualBox" Content="Manual presence penalty (-2 to 2)" IsChecked="{Binding PresencePenaltyManual}" />
              <TextBox Name="PresencePenaltyBox" Text="{Binding PresencePenaltyText}" AutomationProperties.Name="Presence penalty" />
              <TextBlock Text="max_tokens (optional positive whole number)" TextWrapping="Wrap" />
              <TextBox Name="MaxTokensBox" Text="{Binding MaxTokensText}" AutomationProperties.Name="max_tokens" />
              <TextBlock Text="max_completion_tokens (optional positive whole number)" TextWrapping="Wrap" />
              <TextBox Name="MaxCompletionTokensBox" Text="{Binding MaxCompletionTokensText}" AutomationProperties.Name="max_completion_tokens" />
            </StackPanel>
          </Expander>
          <Expander Name="RegionsExpander" Header="Target language region mappings" IsVisible="{Binding HasRegionMap}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8" Margin="0,8,0,0">
              <TextBlock Text="{Binding RegionHelp}" Classes="small muted" TextWrapping="Wrap" />
              <TextBlock Text="Chinese (zh)" /><TextBox Name="ChineseRegionBox" Text="{Binding ChineseRegion}" />
              <TextBlock Text="French (fr)" /><TextBox Name="FrenchRegionBox" Text="{Binding FrenchRegion}" />
              <TextBlock Text="Portuguese (pt)" /><TextBox Name="PortugueseRegionBox" Text="{Binding PortugueseRegion}" />
              <TextBlock Text="Other saved mapping entries remain unchanged." Classes="small muted" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
