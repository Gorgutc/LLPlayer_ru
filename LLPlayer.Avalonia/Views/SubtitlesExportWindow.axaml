<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LLPlayer.Avalonia.ViewModels" x:Class="LLPlayer.Avalonia.Views.SubtitlesExportWindow"
        x:DataType="vm:SubtitlesExportViewModel" Classes="dialog" Title="Subtitle export - LLPlayer"
        Width="460" Height="460" MinWidth="360" MinHeight="400" CanResize="True" SizeToContent="Manual">
  <Window.Styles>
    <Style Selector="ListBox.export-choices">
      <Setter Property="SelectionMode" Value="AlwaysSelected" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="4" /></ItemsPanelTemplate>
      </Setter>
    </Style>
  </Window.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,16">
      <TextBlock Text="Subtitle export" Classes="dialog-title" />
      <TextBlock Text="Export captures the subtitles currently available in the selected track." Classes="dialog-description" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,16,0,0">
      <TextBlock Name="ExportMessage" Text="{Binding Message}" TextWrapping="Wrap" Classes="small muted" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Classes="dialog-footer">
        <Button Content="Cancel export" Classes="outline" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" />
        <Button Content="Close" Classes="outline" Click="OnClose" />
        <Button Name="ExportButton" Content="Export..." Command="{Binding ExportCommand}" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="12">
        <StackPanel Spacing="8" IsEnabled="{Binding !Busy}">
          <StackPanel Spacing="2">
            <TextBlock Text="Subtitle track" />
            <ListBox Name="ExportSlot" Classes="export-choices" SelectedIndex="{Binding SelectedSlot}" AutomationProperties.Name="Subtitle track">
              <ListBoxItem Content="Primary" />
              <ListBoxItem Content="Secondary" />
            </ListBox>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="Text" />
            <ListBox Name="ExportText" Classes="export-choices" ItemsSource="{Binding TextOptions}" SelectedIndex="{Binding SelectedTextIndex}" AutomationProperties.Name="Text to export" />
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="Format" />
            <ListBox Name="ExportFormat" Classes="export-choices" ItemsSource="{Binding FormatOptions}" SelectedIndex="{Binding SelectedFormatIndex}" AutomationProperties.Name="Export format" />
          </StackPanel>
          <TextBlock Text="SRT and WebVTT keep original-text italics. TXT contains plain transcript text." Classes="small muted" TextWrapping="Wrap" />
          <CheckBox Name="ExportSpeakerLabels" Content="Include speaker labels (SRT only)" IsEnabled="{Binding CanIncludeSpeakerLabels}" IsChecked="{Binding IncludeSpeakerLabels}" />
          <CheckBox Name="ExportBom" Content="With UTF-8 BOM" IsChecked="{Binding IsUtf8Bom}" />
        </StackPanel>
        <TextBlock Name="ExportPartialWarning" IsVisible="{Binding IsPartial}" Text="ASR/OCR is running. Only the subtitles captured when you choose Export will be saved." TextWrapping="Wrap" Classes="small muted" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
