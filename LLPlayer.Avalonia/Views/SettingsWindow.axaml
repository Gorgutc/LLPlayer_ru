<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LLPlayer.Avalonia.ViewModels" xmlns:c="using:LLPlayer.Avalonia.Controls" xmlns:services="using:LLPlayer.Avalonia.Services" x:Class="LLPlayer.Avalonia.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel" Title="Settings — LLPlayer" Width="760" Height="550"
        MinWidth="560" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Shadcn.BackgroundBrush}">
  <Window.Resources>
    <DataTemplate x:Key="FontFamilyTemplate" x:DataType="x:String">
      <TextBlock Text="{Binding Converter={x:Static services:SubtitleFontCatalog.DisplayNameConverter}}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
  </Window.Resources>
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Margin="0,0,0,18" Spacing="4">
      <TextBlock Text="Settings" Classes="dialog-title" />
      <TextBlock Text="Appearance and subtitle preferences for this player." Classes="dialog-description" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="132,*" ColumnSpacing="20">
      <ListBox Name="SettingsNavigation" SelectedIndex="{Binding SelectedSection}" VerticalAlignment="Top">
        <ListBoxItem Content="Appearance" />
        <ListBoxItem Content="Subtitles" />
        <ListBoxItem Content="Tools" />
      </ListBox>
      <ScrollViewer Name="SettingsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
          <StackPanel Name="AppearancePage" IsVisible="{Binding AppearanceSelected}" Spacing="14">
            <TextBlock Text="Appearance" Classes="dialog-title" />
            <TextBlock Text="Theme" />
            <ComboBox Name="ThemeEditor" ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Name="SubtitlesPage" IsVisible="{Binding SubtitlesSelected}" Spacing="14">
            <TextBlock Text="Subtitles" Classes="dialog-title" />
            <CheckBox Name="SubtitlesVisibleEditor" Content="Show subtitle overlay" IsChecked="{Binding SubtitlesVisible}" />
            <TextBlock Text="Subtitles sidebar" Classes="dialog-title" />
            <TextBlock Text="Sidebar-only options. The font, size and padding apply to the cue rows and never to the video overlay." Classes="dialog-description" TextWrapping="Wrap" />
            <CheckBox Name="SidebarVisibleEditor" Content="Show subtitle sidebar" IsChecked="{Binding SidebarVisible}"
                      AutomationProperties.Name="Show subtitle sidebar" />
            <TextBlock Text="Sidebar width (220–900 DIP)" />
            <NumericUpDown Name="SidebarWidthEditor" Minimum="220" Maximum="900" Increment="10" NumberFormat="{Binding NumberFormat}" Text="{Binding SidebarWidthText, Mode=TwoWay}" FormatString="0"
                           AutomationProperties.Name="Sidebar width in DIP" />
            <CheckBox Name="SidebarLeftEditor" Content="Dock sidebar on the left" IsChecked="{Binding SidebarLeft}"
                      AutomationProperties.Name="Dock sidebar on the left" />
            <CheckBox Name="SidebarTextMaskEditor" Content="Mask subtitles after the current cue (spoiler protection)" IsChecked="{Binding SidebarTextMask}"
                      AutomationProperties.Name="Mask subtitles after the current cue"
                      AutomationProperties.HelpText="Replaces cue text after the playing cue with underscores. Times and seeking stay available; the hidden text is never used by word lookup." />
            <CheckBox Name="SidebarShowOriginalTextEditor" Content="Show original text when translating enabled" IsChecked="{Binding SidebarShowOriginalText}"
                      AutomationProperties.Name="Show original text when translating enabled"
                      AutomationProperties.HelpText="Shows source text instead of translated text in the sidebar and searches the same choice. Video overlays and engine translation are unchanged." />
            <TextBlock Text="Subtitle padding (0–48 DIP)" />
            <NumericUpDown Name="SidebarSubPaddingEditor" Minimum="0" Maximum="48" Increment="1" NumberFormat="{Binding NumberFormat}" Text="{Binding SidebarSubPaddingText, Mode=TwoWay}" FormatString="0"
                           AutomationProperties.Name="Sidebar subtitle padding in DIP" />
            <TextBlock Text="Sidebar font family" />
            <ComboBox Name="SidebarFontFamilyEditor" ItemsSource="{Binding SidebarFontFamilies}" SelectedItem="{Binding SidebarFontFamily, Mode=TwoWay}"
                      ItemTemplate="{StaticResource FontFamilyTemplate}" HorizontalAlignment="Stretch" MaxDropDownHeight="240"
                      AutomationProperties.Name="Sidebar font family" AutomationProperties.HelpText="Missing requested fonts are retained and use the app Inter fallback; no fonts are installed." />
            <TextBlock Text="Sidebar font weight" />
            <ComboBox Name="SidebarFontWeightEditor" ItemsSource="{x:Static vm:SettingsViewModel.SidebarFontWeights}" SelectedItem="{Binding SidebarFontWeight, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Sidebar font weight" />
            <TextBlock Text="Sidebar font size (8–72 DIP)" />
            <NumericUpDown Name="SidebarFontSizeEditor" Minimum="8" Maximum="72" Increment="1" NumberFormat="{Binding NumberFormat}" Text="{Binding SidebarFontSizeText, Mode=TwoWay}" FormatString="0.#"
                           AutomationProperties.Name="Sidebar font size in DIP" />
            <TextBlock Text="{Binding SidebarFontStatus}" Classes="dialog-description" TextWrapping="Wrap" />
            <TextBlock Text="Primary font" FontWeight="SemiBold" />
            <TextBlock Text="Font family" />
            <ComboBox Name="SubtitleFontFamilyEditor" ItemsSource="{Binding SubtitleFontFamilies}" SelectedItem="{Binding SubtitleFontFamily, Mode=TwoWay}"
                      ItemTemplate="{StaticResource FontFamilyTemplate}" HorizontalAlignment="Stretch" MaxDropDownHeight="240"
                      AutomationProperties.Name="Primary subtitle font family" AutomationProperties.HelpText="Default uses the bundled app Inter font. Missing requested fonts are retained and use Inter as a fallback." />
            <TextBlock Text="Font weight" />
            <ComboBox Name="SubtitleFontWeightEditor" ItemsSource="{x:Static services:SubtitleFontCatalog.Weights}" SelectedItem="{Binding SubtitleFontWeight, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Primary subtitle font weight" />
            <TextBlock Text="Font style" />
            <ComboBox Name="SubtitleFontStyleEditor" ItemsSource="{x:Static services:SubtitleFontCatalog.Styles}" SelectedItem="{Binding SubtitleFontStyle, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Primary subtitle font style" />
            <TextBlock Text="{Binding SubtitleFontStatus}" Classes="dialog-description" TextWrapping="Wrap" />
            <TextBlock Text="Secondary font" FontWeight="SemiBold" />
            <CheckBox Name="SecondarySubtitleInheritsFontEditor" Content="Inherit primary font" IsChecked="{Binding SecondarySubtitleInheritsFont, Mode=TwoWay}"
                      AutomationProperties.Name="Secondary subtitle inherits primary font" AutomationProperties.HelpText="Inherits only family, weight and style. Secondary size, scale, colors and outline remain independent. Turning this off restores retained secondary font overrides." />
            <TextBlock Text="Font family" />
            <ComboBox Name="SecondarySubtitleFontFamilyEditor" ItemsSource="{Binding SubtitleFontFamilies}" SelectedItem="{Binding SecondarySubtitleFontFamily, Mode=TwoWay}"
                      ItemTemplate="{StaticResource FontFamilyTemplate}" HorizontalAlignment="Stretch" MaxDropDownHeight="240" IsEnabled="{Binding SecondaryFontOverridesEnabled}"
                      AutomationProperties.Name="Secondary subtitle font family" />
            <TextBlock Text="Font weight" />
            <ComboBox Name="SecondarySubtitleFontWeightEditor" ItemsSource="{x:Static services:SubtitleFontCatalog.Weights}" SelectedItem="{Binding SecondarySubtitleFontWeight, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" IsEnabled="{Binding SecondaryFontOverridesEnabled}" AutomationProperties.Name="Secondary subtitle font weight" />
            <TextBlock Text="Font style" />
            <ComboBox Name="SecondarySubtitleFontStyleEditor" ItemsSource="{x:Static services:SubtitleFontCatalog.Styles}" SelectedItem="{Binding SecondarySubtitleFontStyle, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" IsEnabled="{Binding SecondaryFontOverridesEnabled}" AutomationProperties.Name="Secondary subtitle font style" />
            <TextBlock Text="{Binding SecondarySubtitleFontStatus}" Classes="dialog-description" TextWrapping="Wrap" />
            <Button Name="CopyPrimaryFontButton" Content="Copy Primary" Classes="outline" Command="{Binding CopyPrimaryFontCommand}" HorizontalAlignment="Stretch"
                    AutomationProperties.HelpText="Copies the requested primary family, weight and style into secondary and turns inheritance off. This is a snapshot." />
            <Button Name="ResetSecondaryFontButton" Content="Reset Secondary" Classes="outline" Command="{Binding ResetSecondaryFontCommand}" HorizontalAlignment="Stretch"
                    AutomationProperties.HelpText="Enables font inheritance and retains the secondary overrides. Other subtitle settings stay as they are." />
            <Button Name="ResetSubtitleFontsButton" Content="Reset Fonts" Classes="outline" Command="{Binding ResetSubtitleFontsCommand}" HorizontalAlignment="Stretch"
                    AutomationProperties.HelpText="Resets the two font tuples and inheritance only. Sizes, scale, colors, outline and position stay as they are." />
            <TextBlock Text="Font and background preview" FontWeight="SemiBold" />
            <TextBlock Text="Preview of font family, weight, style and background. Save &amp; Close applies the settings to the player." Classes="dialog-description" TextWrapping="Wrap" />
            <Border Padding="12" Background="#202020" CornerRadius="4">
              <StackPanel Spacing="8">
                <c:SubtitleText Name="SubtitleFontPreview" Text="Primary subtitle&#10;Second line" IsHitTestVisible="False" Focusable="False"
                                TextAlignment="{Binding PreviewTextAlignment}" IgnoreLineBreaks="{Binding SubtitleIgnoreLineBreak}"
                                FontFamily="{Binding PreviewSubtitleFontFamily}" FontWeight="{Binding PreviewSubtitleFontWeight}" FontStyle="{Binding PreviewSubtitleFontStyle}"
                                FontSize="{Binding SubtitleFontSize}" Fill="{Binding SubtitleTextBrush}" Outline="{Binding SubtitleOutlineBrush}" OutlineThickness="{Binding SubtitleOutlineThickness}" Background="{Binding SubtitleBackgroundBrush}"
                                AutomationProperties.Name="Primary subtitle font preview" />
                <c:SubtitleText Name="SecondarySubtitleFontPreview" Text="Secondary subtitle&#10;Second line" Slot="1" IsHitTestVisible="False" Focusable="False"
                                TextAlignment="{Binding PreviewTextAlignment}" IgnoreLineBreaks="{Binding SubtitleIgnoreLineBreak}"
                                FontFamily="{Binding PreviewSecondarySubtitleFontFamily}" FontWeight="{Binding PreviewSecondarySubtitleFontWeight}" FontStyle="{Binding PreviewSecondarySubtitleFontStyle}"
                                FontSize="{Binding PreviewSecondarySubtitleFontSize}" Fill="{Binding SecondarySubtitleTextBrush}" Outline="{Binding SubtitleOutlineBrush}" OutlineThickness="{Binding SecondarySubtitleOutlineThickness}" Background="{Binding SecondarySubtitleBackgroundBrush}"
                                AutomationProperties.Name="Secondary subtitle font preview" />
              </StackPanel>
            </Border>
            <TextBlock Text="Primary font size (12–96 DIP)" />
            <NumericUpDown Name="FontSizeEditor" Minimum="12" Maximum="96" Increment="2" NumberFormat="{Binding NumberFormat}" Text="{Binding SubtitleFontSizeText, Mode=TwoWay}" FormatString="0.#" />
            <TextBlock Text="Secondary font scale (0.4–1.5 × primary)" TextWrapping="Wrap" />
            <NumericUpDown Name="ScaleEditor" Minimum="0.4" Maximum="1.5" Increment="0.05" NumberFormat="{Binding NumberFormat}" Text="{Binding SecondaryFontScaleText, Mode=TwoWay}" FormatString="0.##" />
            <TextBlock Text="Text subtitle bottom offset (0–400 DIP)" TextWrapping="Wrap" />
            <NumericUpDown Name="PositionEditor" Minimum="0" Maximum="400" Increment="8" NumberFormat="{Binding NumberFormat}" Text="{Binding SubtitleBottomOffsetText, Mode=TwoWay}" AutomationProperties.Name="Text subtitle bottom offset (0–400 DIP)" />
            <TextBlock Text="Primary text subtitle outline thickness (0–8 DIP)" TextWrapping="Wrap" />
            <NumericUpDown Name="PrimaryOutlineEditor" Minimum="0" Maximum="8" Increment="0.25" NumberFormat="{Binding NumberFormat}" Text="{Binding SubtitleOutlineThicknessText, Mode=TwoWay}" AutomationProperties.Name="Primary text subtitle outline thickness (0–8 DIP)" />
            <TextBlock Text="Secondary text subtitle outline thickness (0–8 DIP)" TextWrapping="Wrap" />
            <NumericUpDown Name="SecondaryOutlineEditor" Minimum="0" Maximum="8" Increment="0.25" NumberFormat="{Binding NumberFormat}" Text="{Binding SecondarySubtitleOutlineThicknessText, Mode=TwoWay}" AutomationProperties.Name="Secondary text subtitle outline thickness (0–8 DIP)" />
            <TextBlock Text="Zero removes the outline; the existing shadow remains." Classes="dialog-description" TextWrapping="Wrap" />
            <TextBlock Text="Text subtitle outline color (primary and secondary)" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBox Name="SubtitleOutlineColorEditor" Text="{Binding SubtitleOutlineColor, Mode=TwoWay}"
                       AutomationProperties.Name="Text subtitle outline color (primary and secondary)"
                       AutomationProperties.HelpText="Use #RRGGBB, for example #000000. Applies to both primary and secondary text subtitle outlines." />
              <Border Name="SubtitleOutlineColorSwatch" Grid.Column="1" Width="36" Height="36"
                      Background="{Binding SubtitleOutlineBrush}" BorderThickness="1" BorderBrush="{DynamicResource Shadcn.BorderBrush}"
                      CornerRadius="4" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Use #RRGGBB (for example #000000). Applies to both primary and secondary text subtitle outlines."
                       Classes="dialog-description" TextWrapping="Wrap" />
            <TextBlock Text="Primary text subtitle color" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBox Name="PrimaryTextColorEditor" Text="{Binding SubtitleTextColor, Mode=TwoWay}"
                       AutomationProperties.Name="Primary text subtitle color"
                       AutomationProperties.HelpText="Use #RRGGBB, for example #FFFFFF." />
              <Border Name="PrimaryTextColorSwatch" Grid.Column="1" Width="36" Height="36"
                      Background="{Binding SubtitleTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource Shadcn.BorderBrush}"
                      CornerRadius="4" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Secondary text subtitle color" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBox Name="SecondaryTextColorEditor" Text="{Binding SecondarySubtitleTextColor, Mode=TwoWay}"
                       AutomationProperties.Name="Secondary text subtitle color"
                       AutomationProperties.HelpText="Use #RRGGBB, for example #E8E8E8." />
              <Border Name="SecondaryTextColorSwatch" Grid.Column="1" Width="36" Height="36"
                      Background="{Binding SecondarySubtitleTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource Shadcn.BorderBrush}"
                      CornerRadius="4" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Use #RRGGBB (for example #FFFFFF). Colors apply to text subtitle overlays."
                       Classes="dialog-description" TextWrapping="Wrap" />
            <TextBlock Text="Text subtitle background color (primary and secondary)" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBox Name="SubtitleBackgroundColorEditor" Text="{Binding SubtitleBackgroundColor, Mode=TwoWay}"
                       AutomationProperties.Name="Text subtitle background color (primary and secondary)"
                       AutomationProperties.HelpText="Use #RRGGBB, for example #000000. Applies to both primary and secondary text subtitle backgrounds." />
              <Border Name="SubtitleBackgroundColorSwatch" Grid.Column="1" Width="36" Height="36"
                      Background="{Binding SubtitleBackgroundColorBrush}" BorderThickness="1" BorderBrush="{DynamicResource Shadcn.BorderBrush}"
                      CornerRadius="4" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Primary text subtitle background opacity (0–100%)" TextWrapping="Wrap" />
            <TextBox Name="PrimaryBackgroundOpacityEditor" Text="{Binding SubtitleBackgroundOpacityPercentText, Mode=TwoWay}"
                     AutomationProperties.Name="Primary text subtitle background opacity (0–100%)"
                     AutomationProperties.HelpText="Use a whole number from 0 to 100. Zero removes the background without changing the text or outline." />
            <TextBlock Text="Secondary text subtitle background opacity (0–100%)" TextWrapping="Wrap" />
            <TextBox Name="SecondaryBackgroundOpacityEditor" Text="{Binding SecondarySubtitleBackgroundOpacityPercentText, Mode=TwoWay}"
                     AutomationProperties.Name="Secondary text subtitle background opacity (0–100%)"
                     AutomationProperties.HelpText="Use a whole number from 0 to 100. Independent of primary opacity and font inheritance." />
            <TextBlock Text="Use #RRGGBB (for example #000000) and whole opacity percentages from 0 to 100. Zero removes the background. Font inheritance does not change background opacity."
                       Classes="dialog-description" TextWrapping="Wrap" />
            <Button Name="ResetSubtitleBackgroundButton" Content="Reset Background" Classes="outline" Command="{Binding ResetSubtitleBackgroundCommand}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Reset text subtitle backgrounds"
                    AutomationProperties.HelpText="Resets the shared background color to black and both background opacities to zero. Other settings stay as they are." />
            <TextBlock Text="Text subtitle box size" FontWeight="SemiBold" />
            <TextBlock Text="Subtitle width (1–100 % of the video column width after the 48-DIP side margins)" TextWrapping="Wrap" />
            <NumericUpDown Name="SubtitleWidthEditor" Minimum="1" Maximum="100" Increment="5" NumberFormat="{Binding NumberFormat}" Text="{Binding SubtitleWidthPercentText, Mode=TwoWay}" FormatString="0"
                           AutomationProperties.Name="Text subtitle box width percentage" />
            <TextBlock Text="Max width (0–4000 DIP, 0 = no limit)" TextWrapping="Wrap" />
            <NumericUpDown Name="SubtitleMaxWidthEditor" Minimum="0" Maximum="4000" Increment="50" NumberFormat="{Binding NumberFormat}" Text="{Binding SubtitleMaxWidthText, Mode=TwoWay}" FormatString="0.#"
                           AutomationProperties.Name="Text subtitle max width in DIP" />
            <TextBlock Text="Primary/secondary distance (0–200 DIP)" TextWrapping="Wrap" />
            <NumericUpDown Name="SubtitleDistanceEditor" Minimum="0" Maximum="200" Increment="1" NumberFormat="{Binding NumberFormat}" Text="{Binding SubtitlePrimarySecondaryDistanceText, Mode=TwoWay}" FormatString="0.#"
                           AutomationProperties.Name="Distance between primary and secondary subtitles" />
            <CheckBox Name="IgnoreLineBreakEditor" Content="Ignore line breaks" IsChecked="{Binding SubtitleIgnoreLineBreak}"
                      AutomationProperties.HelpText="Draw cue line breaks as spaces; wrapping still applies." />
            <TextBlock Text="Line alignment" />
            <ComboBox Name="SubtitleAlignmentEditor" ItemsSource="{x:Static vm:SettingsViewModel.LineAlignments}" SelectedItem="{Binding SubtitleLineAlignment, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Text subtitle line alignment" />
            <TextBlock Text="Separator max width (0–2000 DIP, 0 = no line)" TextWrapping="Wrap" />
            <NumericUpDown Name="SubtitleSeparatorWidthEditor" Minimum="0" Maximum="2000" Increment="20" NumberFormat="{Binding NumberFormat}" Text="{Binding SubtitleSeparatorMaxWidthText, Mode=TwoWay}" FormatString="0.#"
                           AutomationProperties.Name="Dual subtitle separator max width in DIP" />
            <TextBlock Text="Separator opacity (0–100 %)" TextWrapping="Wrap" />
            <NumericUpDown Name="SubtitleSeparatorOpacityEditor" Minimum="0" Maximum="100" Increment="1" NumberFormat="{Binding NumberFormat}" Text="{Binding SubtitleSeparatorOpacityPercentText, Mode=TwoWay}" FormatString="0"
                           AutomationProperties.Name="Dual subtitle separator opacity percentage" />
            <TextBlock Text="Position alignment (block edge anchored at the bottom distance)" TextWrapping="Wrap" />
            <ComboBox Name="PositionAlignmentEditor" ItemsSource="{x:Static vm:SettingsViewModel.PositionAlignments}" SelectedItem="{Binding SubtitlePositionAlignment, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Subtitle position alignment" />
            <TextBlock Text="Position alignment when dual subtitles are shown" TextWrapping="Wrap" />
            <ComboBox Name="PositionAlignmentDualEditor" ItemsSource="{x:Static vm:SettingsViewModel.PositionAlignments}" SelectedItem="{Binding SubtitlePositionAlignmentWhenDual, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Subtitle position alignment when dual subtitles are shown" />
            <TextBlock Text="Bitmap subtitles (live session values; reset when a media opens)" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Bitmap scale primary (0.1–8)" TextWrapping="Wrap" />
            <NumericUpDown Name="PrimaryBitmapScaleEditor" Minimum="0.1" Maximum="8" Increment="0.05" NumberFormat="{Binding NumberFormat}" Text="{Binding PrimaryBitmapScaleText, Mode=TwoWay}" FormatString="0.##"
                           AutomationProperties.Name="Primary bitmap subtitle scale" />
            <TextBlock Text="Bitmap scale secondary (0.1–8)" TextWrapping="Wrap" />
            <NumericUpDown Name="SecondaryBitmapScaleEditor" Minimum="0.1" Maximum="8" Increment="0.05" NumberFormat="{Binding NumberFormat}" Text="{Binding SecondaryBitmapScaleText, Mode=TwoWay}" FormatString="0.##"
                           AutomationProperties.Name="Secondary bitmap subtitle scale" />
            <TextBlock Text="Bitmap position primary (0–150 %)" TextWrapping="Wrap" />
            <NumericUpDown Name="PrimaryBitmapPositionEditor" Minimum="0" Maximum="150" Increment="1" NumberFormat="{Binding NumberFormat}" Text="{Binding PrimaryBitmapPositionText, Mode=TwoWay}" FormatString="0"
                           AutomationProperties.Name="Primary bitmap subtitle position percentage" />
            <TextBlock Text="The two-line preview shows alignment and line-break handling; box, separator and alignment values apply to the video overlay, bitmap values to the engine session." Classes="dialog-description" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Name="ToolsPage" IsVisible="{Binding ToolsSelected}" Spacing="6">
            <TextBlock Text="Tools" Classes="dialog-title" />
            <TextBlock Text="Opening a tool closes Settings and discards unsaved edits here." Classes="dialog-description" />
            <TextBlock Text="Language learning" FontWeight="SemiBold" />
            <Button Name="TranslationLink" Content="Translation settings…" Classes="outline" Command="{Binding OpenToolCommand}" CommandParameter="{x:Static vm:SettingsLink.Translation}" HorizontalAlignment="Stretch" />
            <Button Name="RecognitionLink" Content="Recognition (ASR / OCR)…" Classes="outline" Command="{Binding OpenToolCommand}" CommandParameter="{x:Static vm:SettingsLink.Recognition}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Word" FontWeight="SemiBold" />
            <TextBlock Text="Word click action (dictionary definition is edited in Translation settings)" Classes="dialog-description" TextWrapping="Wrap" />
            <ComboBox Name="WordClickActionEditor" ItemsSource="{x:Static vm:SettingsViewModel.WordClickActions}" SelectedItem="{Binding WordClickAction, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Word click action" />
            <TextBlock Text="Translation opens the dictionary popup; Clipboard copies the clicked word; ClipboardAll copies the clicked cue." Classes="dialog-description" TextWrapping="Wrap" />
            <Button Name="WordManagerLink" Content="Word Manager and Anki export…" Classes="outline" Command="{Binding OpenToolCommand}" CommandParameter="{x:Static vm:SettingsLink.WordManager}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Anki" FontWeight="SemiBold" />
            <TextBlock Text="Default deck name for .apkg and AnkiConnect exports (TSV has no deck column; blank means LLPlayer, up to 64 characters)" Classes="dialog-description" TextWrapping="Wrap" />
            <TextBox Name="AnkiDeckEditor" Text="{Binding AnkiDeck, Mode=TwoWay}" MaxLength="64" AutomationProperties.Name="Default Anki deck name" />
            <TextBlock Text="AnkiConnect stays on the WPF-compatible fixed http://localhost:8765; word context-menu actions, copy-on-select and PDIC remain outside this stage." Classes="dialog-description" TextWrapping="Wrap" />
            <TextBlock Text="Keyboard" FontWeight="SemiBold" />
            <Button Name="ShortcutsLink" Content="Keyboard shortcuts…" Classes="outline" Command="{Binding OpenToolCommand}" CommandParameter="{x:Static vm:SettingsLink.Shortcuts}" HorizontalAlignment="Stretch" />
            <TextBlock Text="App shortcuts (draft; Save applies them; collisions with engine keys are rejected)"
                       Classes="dialog-description" TextWrapping="Wrap" />
            <ItemsControl Name="ShortcutRows" ItemsSource="{Binding ShortcutRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutEditRow">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                    <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <c:ChordCaptureButton Grid.Column="1" Chord="{Binding Chord, Mode=TwoWay}" Content="{Binding Chord}"
                                          Classes="outline" MinWidth="140"
                                          AutomationProperties.Name="{Binding Description}"
                                          AutomationProperties.HelpText="{Binding Chord, StringFormat='Current chord {0}. Click, then press the new chord; Esc cancels.'}"
                                          ToolTip.Tip="Click, then press the new chord; Esc cancels" />
                    <Button Grid.Column="2" Content="Reset" Classes="ghost sm" Command="{Binding ResetCommand}"
                            AutomationProperties.Name="{Binding Description, StringFormat='Reset {0} to its default chord'}"
                            ToolTip.Tip="Restore the default chord" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Engine key bindings" FontWeight="SemiBold" />
            <TextBlock Text="Draft only: Save applies these rows. Only the engine's existing bindings are listed, and duplicate or app-colliding chords are rejected. Adding new action rows is outside this stage."
                       Classes="dialog-description" TextWrapping="Wrap" />
            <Button Name="ResetEngineKeysButton" Content="Reset engine keys to defaults" Classes="outline"
                    Command="{Binding ResetEngineKeysCommand}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Reset engine key bindings to engine defaults"
                    AutomationProperties.HelpText="Replaces the draft rows with the engine's built-in bindings; Save is still required to apply them." />
            <TextBlock Text="No engine bindings in this draft; Reset restores the engine defaults." Classes="dialog-description"
                       TextWrapping="Wrap" IsVisible="{Binding !HasEngineKeyRows}" />
            <ItemsControl Name="EngineKeyRows" ItemsSource="{Binding EngineKeyRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EngineKeyEditRow">
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,3">
                    <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <c:ChordCaptureButton Grid.Column="1" Chord="{Binding Chord, Mode=TwoWay}" Content="{Binding DisplayChord}"
                                          Classes="outline" MinWidth="120" MaxWidth="180"
                                          AutomationProperties.Name="{Binding AccessibleName}"
                                          AutomationProperties.HelpText="{Binding DisplayChord, StringFormat='Current chord {0}. Click, then press the new chord; Esc cancels.'}"
                                          ToolTip.Tip="{Binding DisplayChord, StringFormat='Current chord: {0}. Click, then press the new chord; Esc cancels.'}" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                      <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding AccessibleName, StringFormat='Enable engine binding {0}'}" />
                      <CheckBox Content="On release" IsChecked="{Binding IsKeyUp}" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding AccessibleName, StringFormat='Fire engine binding {0} on release'}" />
                      <Button Content="Delete" Classes="ghost sm" Command="{Binding DeleteCommand}"
                              AutomationProperties.Name="{Binding AccessibleName, StringFormat='Delete engine binding {0}'}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="12" Margin="0,16,0,0">
      <TextBlock Name="SaveError" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Shadcn.DestructiveBrush}"
                       AutomationProperties.LiveSetting="Polite" />
      <StackPanel Classes="dialog-footer">
        <Button Name="CloseButton" Content="Close" Classes="outline" Command="{Binding CloseCommand}" />
        <Button Name="SaveButton" Content="Save &amp; Close" Classes="primary" Command="{Binding SaveCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
