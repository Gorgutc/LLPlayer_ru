<Project Sdk="Microsoft.NET.Sdk">

  <!-- The default Windows/WPF gate keeps its original Windows TFM. The additive native Windows Avalonia
       gate opts into both targets with LLPlayerPortableTests=true, then explicitly runs net10.0.
       Other hosts compile-check the Windows TFM and run the portable net10.0 TFM. -->
  <PropertyGroup>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(LLPlayerPortableTests)' != 'true'">net10.0-windows10.0.18362.0</TargetFramework>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows')) or '$(LLPlayerPortableTests)' == 'true'">net10.0-windows10.0.18362.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>FlyleafLib</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyleafLib\FlyleafLib.csproj" />
    <ProjectReference Include="..\LLPlayer.Core\LLPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.18362.0'">
    <ProjectReference Include="..\LLPlayer\LLPlayer.csproj" />
  </ItemGroup>

  <!-- The WindowsDesktop runtime does not exist off Windows: the Windows TFM is built there but not executed. -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.18362.0' and !$([MSBuild]::IsOSPlatform('Windows'))">
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0'">
    <!-- Explicit RID wins for cross-publishing; ordinary test builds use the executing host. -->
    <_WhisperRuntimeIdentifier>$(RuntimeIdentifier)</_WhisperRuntimeIdentifier>
    <_WhisperRuntimeIdentifier Condition="'$(_WhisperRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</_WhisperRuntimeIdentifier>
    <_WhisperRuntimeIdentifier Condition="'$(_WhisperRuntimeIdentifier)' == ''">linux-x64</_WhisperRuntimeIdentifier>
    <!-- Native paletted OCR fixtures use the same FFmpeg allocation/disposal ownership as decoded subtitles. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Portable (net10.0) test set: files that need WPF / WinForms / GDI+ (Windows-only APIs) are excluded.
       Platform/ holds portable-only tests (excluded from the Windows TFM). -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" ExcludeAssets="build" GeneratePathProperty="true" />
    <PackageReference Condition="'$(_WhisperRuntimeIdentifier)' == 'win-x64'"
                      Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" ExcludeAssets="all" GeneratePathProperty="true" />
    <None Condition="'$(_WhisperRuntimeIdentifier)' == 'win-x64'"
          Include="$(PkgSilk_NET_OpenAL_Soft_Native)/runtimes/win-x64/native/soft_oal.dll"
          TargetPath="soft_oal.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Condition="'$(_WhisperRuntimeIdentifier)' == 'linux-x64'"
          Include="$(PkgWhisper_net_Runtime)/build/linux-x64/libwhisper.so;
                   $(PkgWhisper_net_Runtime)/build/linux-x64/libggml-whisper.so;
                   $(PkgWhisper_net_Runtime)/build/linux-x64/libggml-base-whisper.so;
                   $(PkgWhisper_net_Runtime)/build/linux-x64/libggml-cpu-whisper.so"
          TargetPath="runtimes/linux-x64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Condition="'$(_WhisperRuntimeIdentifier)' == 'win-x64'"
          Include="$(PkgWhisper_net_Runtime)/build/win-x64/whisper.dll;
                   $(PkgWhisper_net_Runtime)/build/win-x64/ggml-whisper.dll;
                   $(PkgWhisper_net_Runtime)/build/win-x64/ggml-base-whisper.dll;
                   $(PkgWhisper_net_Runtime)/build/win-x64/ggml-cpu-whisper.dll"
          TargetPath="runtimes/win-x64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- WPF Application/Popup lifetime of the LLPlayer app (WPF) -->
    <Compile Remove="LLPlayer\**" />
    <!-- WPF (System.Windows.Media.Color) / Vortice color converters that exist only in the Windows build of Utils -->
    <Compile Remove="Utils\UtilsColorConversionTests.cs" />
    <!-- GDI+ ImageProcessor (System.Drawing.Common is Windows-only since .NET 7); portable counterpart: OcrImageProcessor -->
    <Compile Remove="MediaPlayer\ImageProcessorTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'!='net10.0'">
    <Compile Remove="Platform\**" />
  </ItemGroup>

</Project>
