<UserControl x:Class="LLPlayer.Controls.FlyleafBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:LLPlayer.Controls"
             xmlns:resources="clr-namespace:LLPlayer.Resources"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DataContext="{d:DesignInstance local:FlyleafBar}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Slider.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PopupBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Single source of truth for the narrow-bar overflow breakpoint (owner-tunable). Keep it BELOW
                 the 620px volume-slider collapse so volume drops first, then these buttons collapse. -->
            <sys:Double x:Key="BarOverflowThresholdPx">520</sys:Double>
        </ResourceDictionary>
    </UserControl.Resources>

    <materialDesign:Card x:Name="MyCard" TextElement.FontSize="14" TextElement.FontWeight="Medium" TextElement.Foreground="White" FontFamily="{materialDesign:MaterialDesignFont}" VerticalAlignment="Bottom" Focusable="False" Padding="2,4,2,0">
        <materialDesign:Card.Background>
            <SolidColorBrush Color="{Binding FL.PlayerConfig.Video.BackColor}" Opacity="0.15"/>
        </materialDesign:Card.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Margin="5,0,5,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- Current Time | Slider | Duration -->
                <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding FL.Player.CurTime, Converter={StaticResource TicksToTimeConv}}" d:Text="00:00:00"/>
                <Slider
                    Grid.Column="1"
                    Cursor="Hand"
                    AutomationProperties.Name="Seek"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    resources:SliderLayout.BarHeight="{Binding FL.Config.SeekBarHeight}"
                    resources:SliderLayout.TrackHeight="{Binding FL.Config.SeekBarTrackHeight}"
                    resources:SliderLayout.ThumbHeight="{Binding FL.Config.SeekBarThumbHeight}"
                    TickPlacement="{Binding FL.Player.Chapters, Converter={StaticResource ChaptersToTickPlacementConv}}"
                    Ticks="{Binding FL.Player.Chapters, Converter={StaticResource ChaptersToTicksConv}}"
                    IsSelectionRangeEnabled="True" SelectionStart="{Binding RelativeSource={RelativeSource Self}, Path=Value, Mode=OneWay}" Style="{DynamicResource FlyleafSlider}" Focusable="False" Margin="10,0,10,0" VerticalAlignment="Center" Value="{Binding FL.Player.CurTime, Mode=TwoWay, Converter={StaticResource TicksToSecondsConv}}" Maximum="{Binding FL.Player.Duration, Converter={StaticResource TicksToSecondsConv}}">
                    <b:Interaction.Behaviors>
                        <local:SliderToolTipBehavior Chapters="{Binding FL.Player.Chapters}" />
                    </b:Interaction.Behaviors>
                    <Slider.SelectionEnd>
                        <MultiBinding Converter="{StaticResource SumConv}">
                            <Binding Path="SelectionStart" RelativeSource="{RelativeSource Self}" Mode="OneWay"/>
                            <Binding Path="FL.Player.BufferedDuration" Converter="{StaticResource TicksToSecondsConv}" Mode="OneWay"/>
                        </MultiBinding>
                    </Slider.SelectionEnd>
                </Slider>
                <!-- F-12 A-B repeat markers: a separate overlay (NOT the slider's selection-range, which shows
                     buffering) so the A/B band + markers are purely additive over the seek track. -->
                <Canvas x:Name="AbOverlay" Grid.Column="1" Margin="10,0,10,0" IsHitTestVisible="False"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding FL.Player.ABLoopActive, Converter={StaticResource BooleanToVisibilityConv}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <Rectangle Fill="{DynamicResource MaterialDesign.Brush.Primary}" Opacity="0.25" IsHitTestVisible="False"
                               Height="{Binding ActualHeight, ElementName=AbOverlay}"
                               Visibility="{Binding FL.Player.ABLoopEnabled, Converter={StaticResource BooleanToVisibilityConv}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                        <Canvas.Left>
                            <MultiBinding Converter="{StaticResource AbMarkerLeftConv}">
                                <Binding Path="FL.Player.ABLoopA"/>
                                <Binding Path="FL.Player.Duration"/>
                                <Binding Path="ActualWidth" ElementName="AbOverlay"/>
                            </MultiBinding>
                        </Canvas.Left>
                        <Rectangle.Width>
                            <MultiBinding Converter="{StaticResource AbBandWidthConv}">
                                <Binding Path="FL.Player.ABLoopA"/>
                                <Binding Path="FL.Player.ABLoopB"/>
                                <Binding Path="FL.Player.Duration"/>
                                <Binding Path="ActualWidth" ElementName="AbOverlay"/>
                            </MultiBinding>
                        </Rectangle.Width>
                    </Rectangle>
                    <Rectangle Width="2" Fill="{DynamicResource MaterialDesign.Brush.Primary}" IsHitTestVisible="False"
                               Height="{Binding ActualHeight, ElementName=AbOverlay}"
                               Visibility="{Binding FL.Player.HasABLoopA, Converter={StaticResource BooleanToVisibilityConv}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                        <Canvas.Left>
                            <MultiBinding Converter="{StaticResource AbMarkerLeftConv}">
                                <Binding Path="FL.Player.ABLoopA"/>
                                <Binding Path="FL.Player.Duration"/>
                                <Binding Path="ActualWidth" ElementName="AbOverlay"/>
                            </MultiBinding>
                        </Canvas.Left>
                    </Rectangle>
                    <Rectangle Width="2" Fill="{DynamicResource MaterialDesign.Brush.Primary}" IsHitTestVisible="False"
                               Height="{Binding ActualHeight, ElementName=AbOverlay}"
                               Visibility="{Binding FL.Player.HasABLoopB, Converter={StaticResource BooleanToVisibilityConv}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                        <Canvas.Left>
                            <MultiBinding Converter="{StaticResource AbMarkerLeftConv}">
                                <Binding Path="FL.Player.ABLoopB"/>
                                <Binding Path="FL.Player.Duration"/>
                                <Binding Path="ActualWidth" ElementName="AbOverlay"/>
                            </MultiBinding>
                        </Canvas.Left>
                    </Rectangle>
                </Canvas>
                <!-- Remaining time -->
                <!-- TODO: L: config -->
                <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           d:Text="-00:00:00">
                    <TextBlock.Text>
                        <Binding
                            StringFormat="-{0}"
                            Path="FL.Player.RemainingDuration"
                            Converter="{StaticResource TicksToTimeConv}"/>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.Resources>
                    <ResourceDictionary>
                        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ResourceDictionary>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- Play / Pause Button -->
                <Button Grid.Column="0" Command="{Binding FL.Player.Commands.TogglePlayPause}" ToolTip="Play / Pause" AutomationProperties.Name="Play / Pause">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Play}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FL.Player.Status}" Value="Playing">
                                    <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Pause}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Subtitles Primary Button -->
                <Button Click="ButtonBase_OnClick" Grid.Column="1" Content="{materialDesign:PackIcon Kind=CcOutline}" ToolTip="Primary Subtitles" AutomationProperties.Name="Primary Subtitles">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu ItemsSource="{StaticResource MenuSubtitlesStreams}" Style="{StaticResource FlyleafContextMenu}"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Subtitles Secondary Button -->
                <Button Click="ButtonBase_OnClick" Grid.Column="2" Foreground="{DynamicResource MaterialDesignBody}" Content="{materialDesign:PackIcon Kind=CcOutline}" ToolTip="Secondary Subtitles" AutomationProperties.Name="Secondary Subtitles">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu ItemsSource="{StaticResource MenuSubtitlesStreams2}" Style="{StaticResource FlyleafContextMenu}"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Click="ButtonBase_OnClick" Grid.Column="3" Foreground="{DynamicResource MaterialDesignBody}" Content="{materialDesign:PackIcon Kind=MusicBoxOutline}" ToolTip="Audio Streams" AutomationProperties.Name="Audio Streams">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu ItemsSource="{StaticResource MenuAudioStreams}" Style="{StaticResource FlyleafContextMenu}"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Quality + Movies Title. Hosted in a Grid so the title takes the remaining space and
                     ellipsizes instead of overflowing onto the Skip/Volume controls (rank 8 / layout-2). -->
                <Grid Grid.Column="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Click="ButtonBase_OnClick" ToolTip="Video Streams" AutomationProperties.Name="Video Streams">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="{materialDesign:PackIcon Kind=QualityLow}"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu ItemsSource="{StaticResource MenuVideoStreams}" Style="{StaticResource FlyleafContextMenu}"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FL.Player.Video.Height, Converter={StaticResource QualityToLevelsConv}}" Value="Low">
                                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=QualityLow}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FL.Player.Video.Height, Converter={StaticResource QualityToLevelsConv}}" Value="Med">
                                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=QualityMedium}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FL.Player.Video.Height, Converter={StaticResource QualityToLevelsConv}}" Value="High">
                                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=QualityHigh}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FL.Player.Video.Height, Converter={StaticResource QualityToLevelsConv}}" Value="_4K">
                                        <Setter Property="Content" Value="{materialDesign:PackIcon Kind=Video4kBox}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <materialDesign:PackIcon Kind="VideoInputAntenna" Height="20" Width="20" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" VerticalAlignment="Center" Visibility="{Binding FL.Player.IsLive, Converter={StaticResource BooleanToVisibilityConv}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>

                    <!-- ASR status chip: shown only while speech-to-text is actively transcribing.
                         F-04: left-click toggles pause/resume (pause stops at the next chunk boundary and keeps
                         already-produced subtitles); the trailing icon reflects the paused state. -->
                    <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="3" VerticalAlignment="Center" Cursor="Hand"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}"
                            ToolTip="Speech-to-text — left-click to pause / resume (keeps generated subtitles)"
                            Visibility="{Binding FL.Player.IsASRRunning, Converter={StaticResource BooleanToVisibilityConv}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding FL.Action.CmdToggleASRPause}" MouseAction="LeftClick" />
                        </Border.InputBindings>
                        <!-- Foreground adapts (black/white) to the chip's Primary background so a pale synced
                             OS accent stays legible; the accent colour itself is unchanged. -->
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Microphone" Width="16" Height="16" VerticalAlignment="Center" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource OnColorForegroundConv}}"/>
                            <TextBlock Text="ASR" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource OnColorForegroundConv}}"/>
                            <materialDesign:PackIcon Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center"
                                                     Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource OnColorForegroundConv}}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <!-- Running: Pause affordance. Paused: Play (resume) affordance. -->
                                        <Setter Property="Kind" Value="Pause" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FL.Player.IsASRPaused}" Value="True">
                                                <Setter Property="Kind" Value="Play" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontStyle="Italic" FontSize="14" Margin="5,0,0,0" Text="{Binding FL.Player.Playlist.Selected.Title, FallbackValue='Open a file…', TargetNullValue='Open a file…'}" Cursor="Hand" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" AutomationProperties.HelpText="Left-click to open a file; right-click for playlist options">
                        <TextBlock.ToolTip>
                            <ToolTip xml:space="preserve">Left Click: Open File Dialog
Right Click: Open Context Menu</ToolTip>
                        </TextBlock.ToolTip>
                        <TextBlock.InputBindings>
                            <MouseBinding Command="{Binding FL.Player.Commands.OpenFromFileDialog}" MouseAction="LeftClick" />
                        </TextBlock.InputBindings>
                        <TextBlock.ContextMenu>
                            <ContextMenu Style="{StaticResource FlyleafContextMenu}" Opened="OnContextMenuOnOpened" Closed="OnContextMenuOnClosed" MouseMove="OnContextMenuOnMouseMove">
                                <MenuItem Header="Open next" Command="{Binding FL.Action.CmdOpenNextFile}" />
                                <MenuItem Header="Open prev" Command="{Binding FL.Action.CmdOpenPrevFile}" />
                                <MenuItem Header="Open path" Command="{Binding FL.Action.CmdOpenCurrentPath}" />
                                <MenuItem Header="Copy path" Command="{Binding FL.Player.Commands.CopyToClipboard}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="5" Content="{materialDesign:PackIcon Kind=SkipPrevious}" Command="{Binding FL.Player.Commands.Reopen}" CommandParameter="{Binding FL.Player.Playlist.PrevItem}" ToolTip="Previous Playlist Item" AutomationProperties.Name="Previous Playlist Item">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FL.Player.Playlist.PrevItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="6" Content="{materialDesign:PackIcon Kind=SkipNext}" Command="{Binding FL.Player.Commands.Reopen}" CommandParameter="{Binding FL.Player.Playlist.NextItem}" ToolTip="Next Playlist Item" AutomationProperties.Name="Next Playlist Item">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FL.Player.Playlist.NextItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- F-12 A-B Repeat: left-click cycles Set A -> Set B -> Clear; right-click menu for explicit actions.
                     Lit (Primary) while a loop is armed. Hotkeys (unbound by default) live in Settings > Keys. -->
                <Button Grid.Column="7"
                        Command="{Binding FL.Player.Commands.ToggleABLoop}"
                        ToolTip="A-B Repeat — click to set A, then B (loops); click again to clear. Right-click for options"
                        AutomationProperties.Name="A-B Repeat">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=RepeatVariant}"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu Style="{StaticResource FlyleafContextMenu}">
                                        <MenuItem Header="Set point A" Command="{Binding FL.Player.Commands.SetABLoopStart}"/>
                                        <MenuItem Header="Set point B" Command="{Binding FL.Player.Commands.SetABLoopEnd}"/>
                                        <MenuItem Header="Clear A-B" Command="{Binding FL.Player.Commands.ClearABLoop}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FL.Player.ABLoopActive}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Volume Button (Mute/Unmute) -->
                <Button Grid.Column="8" Foreground="{DynamicResource MaterialDesignBody}" Command="{Binding FL.Player.Commands.ToggleMute}" ToolTip="Mute / Unmute" AutomationProperties.Name="Mute / Unmute">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=VolumeHigh}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FL.Player.Audio.Volume, Converter={StaticResource VolumeToLevelsConv}}" Value="Mute">
                                    <Setter Property="Content" Value="{materialDesign:PackIcon Kind=VolumeMute}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FL.Player.Audio.Volume, Converter={StaticResource VolumeToLevelsConv}}" Value="Low">
                                    <Setter Property="Content" Value="{materialDesign:PackIcon Kind=VolumeLow}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FL.Player.Audio.Volume, Converter={StaticResource VolumeToLevelsConv}}" Value="Med">
                                    <Setter Property="Content" Value="{materialDesign:PackIcon Kind=VolumeMedium}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FL.Player.Audio.Mute}" Value="True">
                                    <Setter Property="Content" Value="{materialDesign:PackIcon Kind=VolumeMute}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Volume Slider -->
                <!-- On a narrow bar the volume slider collapses (mute stays available) instead of clipping the
                     edge controls; tune the px threshold via ConverterParameter. -->
                <Slider Grid.Column="9" Style="{DynamicResource FlyleafSlider}" Cursor="Hand" AutomationProperties.Name="Volume" AutomationProperties.HelpText="Volume level, scroll or drag to adjust" Visibility="{Binding ActualWidth, ElementName=MyCard, Converter={StaticResource WidthToVisibilityConv}, ConverterParameter=620}" Foreground="{DynamicResource MaterialDesignBody}" Focusable="False" Margin="0,0,6,0" Width="100" VerticalAlignment="Center" Minimum="0" Maximum="{Binding FL.PlayerConfig.Audio.VolumeMax, Mode=OneWay}" d:Maximum="150" d:Value="75" Value="{Binding FL.Player.Audio.Volume}"/>

                <!-- Open Settings Button — collapses into the overflow kebab on a narrow bar (after the volume slider). -->
                <Button Grid.Column="10" Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=SettingsOutline}" Command="{Binding FL.Action.CmdOpenWindowSettings}" ToolTip="Open Settings" AutomationProperties.Name="Open Settings" Visibility="{Binding ActualWidth, ElementName=MyCard, Converter={StaticResource WidthToVisibilityConv}, ConverterParameter={StaticResource BarOverflowThresholdPx}}"/>

                <!-- Toggle Sub Sidebar — collapses into the overflow kebab on a narrow bar (after the volume slider). -->
                <Button Grid.Column="11" Command="{Binding FL.Action.CmdToggleSidebar}" ToolTip="Toggle Sub Sidebar" AutomationProperties.Name="Toggle Sub Sidebar" Visibility="{Binding ActualWidth, ElementName=MyCard, Converter={StaticResource WidthToVisibilityConv}, ConverterParameter={StaticResource BarOverflowThresholdPx}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="{materialDesign:PackIcon Kind=DockRight}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FL.Config.SidebarLeft}" Value="True">
                                    <Setter Property="Content" Value="{materialDesign:PackIcon Kind=DockLeft}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Overflow kebab: holds the low-priority actions that collapsed off the narrow bar (shown below
                     the 520px gate, i.e. after the volume slider drops at 620). Threshold is owner-tunable.
                     Opened/Closed reuse the existing SetActivity handlers so the bar doesn't auto-hide while open. -->
                <materialDesign:PopupBox Grid.Column="12"
                                         VerticalAlignment="Center"
                                         Focusable="False"
                                         PlacementMode="TopAndAlignCentres"
                                         ToolTip="More controls"
                                         AutomationProperties.Name="More controls"
                                         Opened="OnContextMenuOnOpened"
                                         Closed="OnContextMenuOnClosed"
                                         Visibility="{Binding ActualWidth, ElementName=MyCard, Converter={StaticResource InverseWidthToVisibilityConv}, ConverterParameter={StaticResource BarOverflowThresholdPx}}">
                    <materialDesign:PopupBox.ToggleContent>
                        <materialDesign:PackIcon Kind="DotsVertical" Width="24" Height="24" Foreground="{DynamicResource MaterialDesignBody}" />
                    </materialDesign:PopupBox.ToggleContent>
                    <StackPanel Margin="4">
                        <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Command="{Binding FL.Action.CmdOpenWindowSettings}" AutomationProperties.Name="Open Settings">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SettingsOutline" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Command="{Binding FL.Action.CmdToggleSidebar}" AutomationProperties.Name="Toggle Sub Sidebar">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DockRight" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Toggle Sidebar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:PopupBox>

                <!-- Toggle Fullscreen Button -->
                <ToggleButton Grid.Column="13" Style="{StaticResource MaterialDesignActionToggleButton}" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Background="Transparent" Focusable="False" IsChecked="{Binding FL.Player.Host.IsFullScreen}" Content="{materialDesign:PackIcon Kind=Fullscreen, Size=28}" materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=FullscreenExit, Size=28}" ToolTip="Toggle Fullscreen" AutomationProperties.Name="Toggle Fullscreen"/>
            </Grid>
        </Grid>
    </materialDesign:Card>
</UserControl>
