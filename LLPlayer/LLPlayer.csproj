<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Enabled for the System.Windows.Forms.NotifyIcon system-tray icon (batch background progress).
         WinForms was already pulled in transitively via FlyleafLib; this declares it on the app project. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Authors>umlx5h</Authors>
    <Copyright>umlx5h © 2026</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <ApplicationIcon>LLPlayer.ico</ApplicationIcon>
    <Description>The media player for language learning.</Description>
    <PackageProjectUrl>https://llplayer.com</PackageProjectUrl>
    <Version>0.3.49</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- UseWindowsForms (for the tray NotifyIcon) injects implicit global usings for System.Windows.Forms and
       System.Drawing, which collide with WPF types (Binding/ContextMenu/UserControl/TextBox/Pen/KeyEventArgs)
       across the existing code. Drop those implicit usings; AppTrayService references them explicitly (a
       WinForms alias + a scoped System.Drawing using) so WinForms stays available without the global clash. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Flyleaf.FFmpeg.Bindings" Version="8.0.1" />
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
    <PackageReference Include="LibNMeCab.IpaDicBin" Version="0.10.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.1" />
    <!-- F-10: write Anki .apkg decks (SQLite collection.anki2 + zip). MIT; bundles native e_sqlite3.dll
         (copied to publish output, same as the other native runtime assets). The explicit bundle pin forces
         the patched SQLitePCLRaw 3.0.3 (which ships native e_sqlite3 3.50.3); the whole 2.1.x line carries
         advisory GHSA-2m69-gcr7-jv3q / NU1903 with no 2.1.x fix. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.17" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Prism.DryIoc" Version="9.0.537" />
    <PackageReference Include="Squid-Box.SevenZipSharp.Lite" Version="1.6.2.24" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.OpenVino" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyleafLib\FlyleafLib.csproj" />
    <ProjectReference Include="..\WpfColorFontDialog\WpfColorFontDialog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\completion.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\kennedy.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="lib\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="lib\license.7z.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Ship the AI-dubbing sidecar source beside the exe (DubbingConfig.DefaultServerScript resolves
         BaseDirectory\dub_sidecar\server.py). The heavy venv + model weights are provisioned on first run;
         only our committed GPLv3 scripts are bundled. -->
    <Content Include="..\dub_sidecar\server.py" Link="dub_sidecar\server.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\dub_sidecar\pyproject.toml" Link="dub_sidecar\pyproject.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\dub_sidecar\uv.lock" Link="dub_sidecar\uv.lock" Condition="Exists('..\dub_sidecar\uv.lock')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\dub_sidecar\README.md" Link="dub_sidecar\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\pause.png" />
    <Resource Include="Resources\Images\play.png" />
  </ItemGroup>

</Project>
