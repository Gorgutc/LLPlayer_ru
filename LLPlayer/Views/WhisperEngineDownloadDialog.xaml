<UserControl x:Class="LLPlayer.Views.WhisperEngineDownloadDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:LLPlayer.Views"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WhisperEngineDownloadDialogVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">

    <!--TODO: L: common-->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- ComboBox -->
            <RowDefinition Height="Auto"/>
            <!-- Download & Cancel Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- ProgressBar -->
            <RowDefinition Height="Auto"/>
            <!-- Size Text -->
            <RowDefinition Height="Auto"/>
            <!-- Status Text -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Select engine -->
        <TextBlock  Grid.Row="0" Margin="0 0 0 16" FontWeight="Bold">
        Download <Hyperlink Style="{StaticResource MyHyperLink}" NavigateUri="{Binding Source={x:Static vm:WhisperEngineDownloadDialogVM.EngineURL}}" helpers:HyperlinkHelper.OpenInBrowser="True">
                <TextBlock Text="{Binding Source={x:Static vm:WhisperEngineDownloadDialogVM.EngineFile}}" /></Hyperlink>
                <LineBreak />
            <Run FontWeight="Normal" Text="-> Whisper\Faster-Whisper-XXL\faster-whisper-xxl.exe"/>
        </TextBlock>

        <!-- Download & Cancel button -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <Button
                Content="Download"
                Command="{Binding CmdDownloadEngine}"
                Width="150"
                Height="36"
                Style="{StaticResource M3.FilledButton}"
                Visibility="{Binding CmdDownloadEngine.IsExecuting, Converter={StaticResource BooleanToVisibilityInvertConv}}" />

            <Button
                Content="Cancel"
                Command="{Binding CmdCancelDownloadEngine}"
                Width="150"
                Height="36"
                Style="{StaticResource M3.OutlinedButton}"
                Visibility="{Binding CmdDownloadEngine.IsExecuting, Converter={StaticResource BooleanToVisibilityConv}}"/>

            <Button
                Command="{Binding CmdDeleteEngine}"
                Width="100"
                Height="36"
                Style="{StaticResource M3.TextButton}"
                Margin="10 0 0 0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Text="Delete" Margin="5 0 0 0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button
                ToolTip="Open Folder"
                Style="{StaticResource M3.IconButton.Small}"
                HorizontalAlignment="Center"
                Width="36"
                Height="36"
                Command="{Binding CmdOpenFolder}">
                <materialDesign:PackIcon Kind="Folder" />
            </Button>
        </StackPanel>

        <!-- Progress bar (hidden) -->
        <Border
            Grid.Row="2"
            CornerRadius="{StaticResource M3.Radius.Pill}"
            ClipToBounds="True"
            Margin="0 0 0 10"
            Visibility="{Binding CmdDownloadEngine.IsExecuting, Converter={StaticResource BooleanToVisibilityConv}}">
            <ProgressBar
                Height="6"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                Minimum="0"
                Maximum="{Binding TotalSize}"
                Value="{Binding DownloadedSize}"
                IsIndeterminate="{Binding IsIndeterminateDownload}" />
        </Border>

        <!-- Download Size -->
        <StackPanel
            Orientation="Horizontal"
            Grid.Row="3"
            Margin="0 0 0 10"
            Visibility="{Binding CmdDownloadEngine.IsExecuting, Converter={StaticResource BooleanToVisibilityConv}}">
            <TextBlock
                Text="{Binding DownloadedSize, Converter={StaticResource FileSizeHumanConv}}"
                FontWeight="Bold"/>
            <TextBlock Text=" / " VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalSize, Converter={StaticResource FileSizeHumanConv}}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Status -->
        <Border Grid.Row="4"
                CornerRadius="{StaticResource M3.Radius.16}"
                Padding="14 12"
                VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Background" Value="Transparent"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                Text="{Binding StatusText}"
                TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
