<UserControl x:Class="LLPlayer.Views.BatchSubtitlesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:conv="clr-namespace:LLPlayer.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BatchSubtitlesDialogVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="620" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:TimeSpanShortConverter x:Key="TimeSpanShort" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <!-- Esc closes the dialog, matching native dialog behavior. -->
        <KeyBinding Key="Escape" Command="{Binding CmdCloseDialog}" />
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0 0 10 0"
                VerticalAlignment="Center"
                Text="Folder" />

            <TextBox
                Grid.Column="1"
                Margin="0 0 8 0"
                VerticalAlignment="Center"
                Text="{Binding FolderPath, UpdateSourceTrigger=LostFocus}"
                materialDesign:HintAssist.Hint="Video folder" />

            <Button
                Grid.Column="2"
                Margin="0 0 8 0"
                Command="{Binding CmdBrowseFolder}"
                ToolTip="Select folder">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderOpen" Margin="0 0 6 0" />
                    <TextBlock Text="Browse" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="3"
                Command="{Binding CmdScan}"
                ToolTip="Scan folder">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Magnify" Margin="0 0 6 0" />
                    <TextBlock Text="Scan" />
                </StackPanel>
            </Button>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0 0 0 10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <CheckBox
                    Margin="0 0 18 0"
                    VerticalAlignment="Center"
                    Content="Recursive"
                    ToolTip="Also scan every sub-folder for videos. Results are grouped by folder."
                    IsChecked="{Binding Recursive}" />

                <CheckBox
                    Margin="0 0 18 0"
                    VerticalAlignment="Center"
                    Content="Overwrite existing"
                    IsChecked="{Binding OverwriteExisting}" />
            </StackPanel>

            <TextBlock
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{DynamicResource MaterialDesignBodyLight}"
                Text="{Binding FL.PlayerConfig.Subtitles.TranslateServiceType, StringFormat=Translate: {0} -> Russian}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.2*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <DataGrid
                Grid.Column="0"
                ItemsSource="{Binding JobsView}"
                SelectedItem="{Binding SelectedJob}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserSortColumns="False"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                SelectionMode="Single"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <!-- Group rows by sub-folder (FolderDisplay) so a recursive scan reads folder-by-folder,
                     with a folder header + file count above each group. -->
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2 8 0 2">
                                    <materialDesign:PackIcon Kind="FolderOutline" VerticalAlignment="Center" Margin="0 0 6 0" />
                                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Text="{Binding Name}" />
                                    <TextBlock VerticalAlignment="Center" Margin="8 0 0 0"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" file(s)" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Include}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="56" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                        <!-- Center the cell content (and give the column enough width) so the checkbox and its
                             hover ripple are fully visible and easy to click, not clipped to a sliver. -->
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <CheckBox
                                HorizontalAlignment="Center"
                                ToolTip="Select all / none"
                                AutomationProperties.Name="Select all files"
                                IsThreeState="False"
                                IsChecked="{Binding DataContext.AllIncluded, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip="Include this file in the batch"
                                    AutomationProperties.Name="Include this file in the batch"
                                    IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Phase" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="Subs" Binding="{Binding SubtitleCount}" Width="60" />
                    <DataGridTemplateColumn Header="Progress" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="2 0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="RunningASR">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ProgressBar
                                        Grid.Row="0"
                                        Height="6"
                                        Minimum="0" Maximum="1"
                                        Value="{Binding Progress}"
                                        IsIndeterminate="{Binding IsIndeterminateProgress}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        FontSize="10"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{Binding ProcessedTime, Converter={StaticResource TimeSpanShort}, Mode=OneWay}" />
                                        <Run Text="/" />
                                        <Run Text="{Binding TotalDuration, Converter={StaticResource TimeSpanShort}, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Throughput, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="File" Binding="{Binding MediaPath}" Width="2*" />
                    <DataGridTextColumn Header="Output" Binding="{Binding OutputPath}" Width="2*" />
                    <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*" />
                    <DataGridTemplateColumn Header="" Width="44" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Width="30" Height="30" Padding="0"
                                    HorizontalAlignment="Center"
                                    ToolTip="Retry this file"
                                    AutomationProperties.Name="Retry this file"
                                    Command="{Binding DataContext.CmdRetryJob, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Canceled">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter
                Grid.Column="1"
                Width="4"
                Margin="6 0"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="{DynamicResource MaterialDesignDivider}" />

            <DockPanel Grid.Column="2">
                <TextBlock
                    DockPanel.Dock="Top"
                    Margin="0 0 0 4"
                    FontWeight="Bold"
                    Text="Live transcript" />
                <TextBlock
                    DockPanel.Dock="Top"
                    Margin="0 0 0 6"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    Text="{Binding ActiveJob.MediaPath}" />
                <Border
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                    <ListBox
                        x:Name="TranscriptList"
                        ItemsSource="{Binding ActiveJob.Transcript}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0 12 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding SummaryText}" />

            <Button
                Grid.Column="1"
                Margin="8 0 0 0"
                Command="{Binding CmdStart}"
                ToolTip="Start batch">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Margin="0 0 6 0" />
                    <TextBlock Text="Start" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Margin="8 0 0 0"
                Command="{Binding CmdCancel}"
                ToolTip="Cancel batch">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Stop" Margin="0 0 6 0" />
                    <TextBlock Text="Cancel" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="3"
                Margin="8 0 0 0"
                Command="{Binding CmdRetryFailed}"
                ToolTip="Retry all failed files">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Margin="0 0 6 0" />
                    <TextBlock Text="Retry failed" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="4"
                Margin="8 0 0 0"
                Command="{Binding CmdOpenOutputFolder}"
                ToolTip="Open output folder">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderOpen" Margin="0 0 6 0" />
                    <TextBlock Text="Output" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="5"
                Margin="8 0 0 0"
                Command="{Binding CmdCloseDialog}"
                ToolTip="Close">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Margin="0 0 6 0" />
                    <TextBlock Text="Close" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
