<UserControl x:Class="LLPlayer.Views.SubtitlesDownloaderDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Views"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SubtitlesDownloaderDialogVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="Spinner" TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignCircularProgressBar}">
                <Setter Property="IsIndeterminate" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
            </Style>
            <!-- M3: rose-tonal selected row on the results DataGrid -->
            <Style x:Key="M3.ResultRow" TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2EECB3C4" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TODO: L: Add language filter -->
        <!-- Search Bar -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                FontSize="18"
                Text="Query:"
                Foreground="{DynamicResource MaterialDesignBodyLight}"
                VerticalAlignment="Center"
                Margin="0,0,8,0"/>
            <TextBox
                Grid.Column="1"
                Style="{StaticResource MaterialDesignFilledTextBox}"
                materialDesign:TextFieldAssist.TextFieldCornerRadius="16 16 0 0"
                FontSize="18"
                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                Padding="8 6"
                VerticalAlignment="Center"/>

            <Button
                Grid.Column="2"
                Style="{StaticResource M3.FilledButton}"
                IsDefault="True"
                Command="{Binding CmdSearch}"
                Content="Search"
                FontSize="16"
                Margin="8 0 0 0" />
        </Grid>

        <Grid Grid.Row="1">
            <DataGrid
                ItemsSource="{Binding Subs}"
                SelectedItem="{Binding SelectedSub}"
                RowStyle="{StaticResource M3.ResultRow}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single"
                CanUserAddRows="False"
                Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Language" Binding="{Binding LanguageName}" Width="100" SortDirection="Ascending" />
                    <DataGridTextColumn Header="FileName" Binding="{Binding SubFileName}" Width="*" />
                    <DataGridTextColumn Header="Format" Binding="{Binding SubFormat}" Width="Auto" />
                    <DataGridTextColumn Header="Duration" Binding="{Binding SubLastTS}" Width="Auto" />
                    <DataGridTextColumn Header="Year" Binding="{Binding MovieYear}" Width="Auto" />
                    <DataGridTextColumn Header="Downloads" Binding="{Binding SubDownloadsCnt}" Width="Auto" />
                    <DataGridTextColumn Header="Rating" Binding="{Binding SubRating}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <!--Spinner on DataGrid-->
            <ProgressBar
                Visibility="{Binding CmdSearch.IsExecuting, Converter={StaticResource BooleanToVisibilityConv}}"
                Style="{StaticResource Spinner}"
                Width="40"
                Height="40"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Button
                    Style="{StaticResource M3.FilledButton}"
                    Command="{Binding CmdLoad}"
                    Margin="0 0 8 0">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar
                            Visibility="{Binding CmdLoad.IsExecuting, Converter={StaticResource BooleanToVisibilityConv}}"
                            Style="{StaticResource Spinner}"
                            Margin="0 0 5 0" />
                        <TextBlock Text="Load" FontSize="16" />
                    </StackPanel>
                </Button>

                <!-- TODO: L: Support for multiple downloads -->
                <Button
                    Style="{StaticResource M3.FilledButton}"
                    Command="{Binding CmdDownload}">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar
                            Visibility="{Binding CmdDownload.IsExecuting, Converter={StaticResource BooleanToVisibilityConv}}"
                            Style="{StaticResource Spinner}" />
                        <TextBlock Text="Download" FontSize="16" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
