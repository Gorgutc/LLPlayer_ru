<UserControl x:Class="LLPlayer.Views.WordManagerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Views"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WordManagerDialogVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: filter + count + delete/clear -->
        <Grid Grid.Row="0" Margin="0 0 0 8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBox Width="240" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         ToolTip="Filter by term, translation, or example"
                         VerticalContentAlignment="Center" />
                <TextBlock Margin="12 0 0 0" VerticalAlignment="Center" Opacity="0.8"
                           Text="{Binding WordCount, StringFormat='{}{0} words'}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Delete" Width="80" Command="{Binding CmdDelete}"
                        ToolTip="Remove the selected word" />
                <Button Content="Clear All" Width="90" Margin="8 0 0 0" Command="{Binding CmdClearAll}"
                        ToolTip="Remove every word from the list" />
            </StackPanel>
        </Grid>

        <!-- Word list -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding WordsView}"
                  SelectedItem="{Binding SelectedWord}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Term" Binding="{Binding Term, Mode=OneWay}" IsReadOnly="True" Width="1.2*" />
                <DataGridTextColumn Header="Reading" Binding="{Binding Reading}" Width="*" />
                <DataGridTextColumn Header="Translation" Binding="{Binding Translation}" Width="1.2*" />
                <DataGridTextColumn Header="Definition" Binding="{Binding Definition}" Width="1.5*" />
                <DataGridTextColumn Header="Example" Binding="{Binding Example}" Width="1.8*" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                <DataGridTextColumn Header="Lang" Binding="{Binding Languages, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                <DataGridTextColumn Header="Saved" Binding="{Binding Saved, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Busy bar -->
        <ProgressBar Grid.Row="2" Margin="0 8 0 0" Height="4" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConv}}" />

        <!-- Export -->
        <Grid Grid.Row="3" Margin="0 10 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="Deck" VerticalAlignment="Center" />
                <TextBox Width="200" Margin="4 0 0 0" VerticalContentAlignment="Center"
                         Text="{Binding DeckName, Mode=TwoWay}"
                         ToolTip="Anki deck name used for .apkg export and AnkiConnect push" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export TSV" Width="100" Command="{Binding CmdExportTsv}"
                        ToolTip="Save a 5-field TSV for Anki's File &#x25b8; Import" />
                <Button Content="Export .apkg" Width="110" Margin="8 0 0 0" Command="{Binding CmdExportApkg}"
                        ToolTip="Save a ready-to-import Anki deck package" />
                <Button Content="Push to Anki" Width="110" Margin="8 0 0 0" Command="{Binding CmdPushAnkiConnect}"
                        ToolTip="Send cards to a running Anki via the AnkiConnect add-on (localhost:8765)" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
