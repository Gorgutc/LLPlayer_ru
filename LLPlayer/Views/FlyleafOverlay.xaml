<UserControl x:Class="LLPlayer.Views.FlyleafOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:flyleaf="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
             xmlns:controls="clr-namespace:LLPlayer.Controls"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             SizeChanged="FlyleafOverlay_OnSizeChanged"
             d:DataContext="{d:DesignInstance vm:FlyleafOverlayVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <prism:InvokeCommandAction Command="{Binding CmdOnLoaded}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <controls:SubtitlesControl />

        <!-- Empty state: shown when no media is loaded. The panel/icon/text have no Background, so clicks and
             drag &amp; drop pass through to the video surface everywhere except the rendered Open File button.
             (Do NOT set IsHitTestVisible=False here — it would also block the button.) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FL.Player.Playlist.Url}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <materialDesign:PackIcon Kind="MovieOpenOutline" Width="72" Height="72" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.5" />
            <TextBlock Text="Open a file or drag &amp; drop here" Margin="0 12 0 0" HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.6" />
            <!-- Primary CTA. Only this button has a rendered background, so clicks/drops elsewhere pass through. -->
            <Button Margin="0 20 0 0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding FL.Player.Commands.OpenFromFileDialog}"
                    ToolTip="Open a media file (Ctrl+O)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderOutline" VerticalAlignment="Center" Margin="0 0 8 0" />
                    <TextBlock Text="Open File" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- Feature teaser: signposts the core language-learning features for first-time users. -->
            <TextBlock Text="Dual subtitles  ·  Speech-to-text  ·  Click a word to translate"
                       Margin="0 18 0 0"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBody}"
                       Opacity="0.7" />
            <!-- Let the user reach Settings / shortcuts before opening any media (e.g. to set up ASR). -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 8 0 0">
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding FL.Action.CmdOpenWindowSettings}"
                        ToolTip="Open Settings (Ctrl+,)"
                        AutomationProperties.Name="Open Settings">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="SettingsOutline" VerticalAlignment="Center" Margin="0 0 6 0" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding FL.Action.CmdOpenWindowCheatSheet}"
                        ToolTip="Keyboard shortcuts (F1)"
                        AutomationProperties.Name="Keyboard shortcuts"
                        Margin="8 0 0 0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="KeyboardOutline" VerticalAlignment="Center" Margin="0 0 6 0" />
                        <TextBlock Text="Shortcuts" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <Grid Margin="6 4 6 4">
            <!-- Debug Info -->
            <!-- TODO: L: make it dedicated window -->
            <flyleaf:PlayerDebug x:Name="playerDebug" DataContext="{Binding FL}" VerticalAlignment="Center" HorizontalAlignment="Center" BoxColor="#AA000000" HeaderColor="White" InfoColor="{DynamicResource MaterialDesign.Brush.Primary.Light}" ValueColor="{DynamicResource MaterialDesign.Brush.Secondary.Light}" Visibility="{Binding Config.ShowDebug, Converter={StaticResource BooleanToVisibilityConv}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                <flyleaf:PlayerDebug.Style>
                    <Style TargetType="flyleaf:PlayerDebug">
                        <Setter Property="Player" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=playerDebug}" Value="Visible">
                                <Setter Property="Player" Value="{Binding Player}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </flyleaf:PlayerDebug.Style>
            </flyleaf:PlayerDebug>

            <!-- timestamp display in upper left corner -->
            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Padding="4" Margin="10 5 0 0" d:Text="00:00:00.000 / 01:42:23.913" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource MaterialDesignBody}">
                <TextBlock.Background>
                    <SolidColorBrush Color="{Binding FL.PlayerConfig.Video.BackColor}" Opacity="0.2" />
                </TextBlock.Background>
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FL.Player.Activity.Mode}" Value="Active" d:Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding FL.Player.CurTime, Mode=OneWay, Converter={StaticResource TicksToTimeSpanConv}, StringFormat={}{0:hh\\:mm\\:ss\\.fff}}" />
                <Run Text="/" />
                <Run Text="{Binding FL.Player.Duration, Mode=OneWay, Converter={StaticResource TicksToTimeSpanConv}, StringFormat={}{0:hh\\:mm\\:ss\\.fff}}" />
            </TextBlock>

            <!-- OSD message in upper right (Icon) -->
            <Border Width="32" Height="32"
                    Visibility="{Binding IsOSDIcon, Converter={StaticResource BooleanToVisibilityConv}}"
                    CornerRadius="15"
                    VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 10 10 0">
                <Border.Background>
                    <SolidColorBrush Color="{Binding FL.PlayerConfig.Video.BackColor}" Opacity="0.2" />
                </Border.Background>
                <materialDesign:PackIcon Kind="{Binding OSDIcon, TargetNullValue={x:Static materialDesign:PackIconKind.None}}"
                    Width="26"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Height="26"
                    Foreground="{DynamicResource MaterialDesignBody}" />
            </Border>

            <!-- OSD message in upper right (Text) -->
            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Right" Padding="4" Margin="0 10 10 0" FontWeight="Bold" d:Text="Volume 50%" FontSize="18" Text="{Binding OSDMessage}" Foreground="{DynamicResource MaterialDesignBody}">
                <TextBlock.Background>
                    <SolidColorBrush Color="{Binding FL.PlayerConfig.Video.BackColor}" Opacity="0.2" />
                </TextBlock.Background>
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FL.Player.Activity.Mode}" Value="Idle" d:Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--Loading Spinner-->
            <!--TODO: L: Binding errors occur in MaterialDesign 5.3.1
            ref: https://github.com/MaterialDesignInXAML/MaterialDesignInXamlToolkit/issues/3814-->
            <ProgressBar
                IsIndeterminate="True"
                Width="50"
                Height="50"
                Style="{StaticResource MaterialDesignCircularProgressBar}"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                Visibility="{Binding FL.Player.IsOpening, Converter={StaticResource BooleanToVisibilityConv}}" />

            <!--Error Message-->
            <TextBox VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" d:Text="Error Message" FontSize="16" IsReadOnly="True" BorderThickness="0" Text="{Binding FL.Player.LastError}" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" TextWrapping="Wrap">
                <TextBox.Background>
                    <SolidColorBrush Color="{Binding FL.PlayerConfig.Video.BackColor}" Opacity="0.15" />
                </TextBox.Background>
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FL.Player.LastError}" Value="{x:Null}" d:Value="notnull">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!--Flyleaf Bar-->
            <controls:FlyleafBar />

            <!--Global Snackbar: notifications + actionable config errors. Hosted in the overlay so it is
                visible in fullscreen too. Anchored top-centre so it never covers the bottom FlyleafBar or
                the subtitle interaction area (which live at the bottom).-->
            <materialDesign:Snackbar
                MessageQueue="{Binding FL.MessageQueue}"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,12,0,0" />
        </Grid>
    </Grid>
</UserControl>
