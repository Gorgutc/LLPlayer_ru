<UserControl x:Class="LLPlayer.Views.ErrorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Views"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DataContext="{d:DesignInstance vm:ErrorDialogVM}"
             d:Foreground="White"
             d:Background="Black"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- TODO: L: animation -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStyle" Value="None" />
            <!--Error dialogs are sometimes displayed behind the MainWindow even though the Owner is set for the Dialog's Window.
            In this case, any operation becomes impossible, so be sure to display it in front of any apps.-->
            <Setter Property="Topmost" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="MouseDown" Handler="Window_MouseDown" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Border
        Focusable="True"
        Loaded="FrameworkElement_OnLoaded"
        MouseLeftButtonDown="ErrorDialog_OnMouseLeftButtonDown">
        <Border.InputBindings>
            <KeyBinding
                Command="{Binding CmdCopyMessage}"
                Key="C"
                Modifiers="Control" />
            <!-- Keyboard-only users can dismiss the error with Escape (the window is otherwise click-to-close). -->
            <KeyBinding
                Command="{Binding CmdCloseDialog}"
                Key="Escape" />
        </Border.InputBindings>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0 0 0 10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                                <DataTrigger.Setters>
                                    <Setter Property="Foreground" Value="#FF5370" />
                                </DataTrigger.Setters>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>

                <InlineUIContainer BaselineAlignment="Center">
                    <!-- Decorative severity glyph; the ErrorTitle Run below carries the accessible name.
                         Intentionally unnamed so a screen reader announces the title once, not "Error <title>". -->
                    <materialDesign:PackIcon
                        Kind="Error"
                        Width="20" Height="20"
                        Margin="0 0 4 0" />
                </InlineUIContainer>
                <Run Text="{Binding ErrorTitle, Mode=OneWay}" />
            </TextBlock>

            <Border
                Grid.Row="1"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="{StaticResource M3.Radius.16}"
                Padding="6"
                VerticalAlignment="Center">
                <TextBox
                    Text="{Binding Message, Mode=OneWay}"
                    FontSize="16"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    ContextMenu="{x:Null}"
                    CommandManager.PreviewExecuted="TextBox_PreviewMouseDown"
                    Background="Transparent"
                    Padding="10"
                    TextAlignment="Left"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesignBody}">
                </TextBox>
            </Border>

            <Expander
                Grid.Row="2"
                Margin="0 12 0 0"
                FontSize="8"
                Header="Exception Details"
                IsExpanded="False"
                Visibility="{Binding HasException, Converter={StaticResource BooleanToVisibilityConv}}">
                <Border
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    CornerRadius="{StaticResource M3.Radius.16}"
                    Padding="6">
                    <TextBox
                        Text="{Binding ExceptionDetail, Mode=OneWay}"
                        IsReadOnly="True"
                        ContextMenu="{x:Null}"
                        CommandManager.PreviewExecuted="TextBox_PreviewMouseDown"
                        Background="Transparent"
                        FontSize="12"
                        TextAlignment="Left"
                        TextWrapping="Wrap"
                        MaxHeight="140" />
                </Border>
            </Expander>

            <Grid Grid.Row="3" Margin="0 12 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Content="Copy to Clipboard"
                    Command="{Binding CmdCopyMessage}"
                    Style="{StaticResource M3.FilledButton}" />

                <Button
                    Grid.Column="2"
                    Content="Close"
                    FontWeight="Bold"
                    IsDefault="True"
                    IsCancel="True"
                    Command="{Binding CmdCloseDialog}"
                    Style="{StaticResource M3.OutlinedButton}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
