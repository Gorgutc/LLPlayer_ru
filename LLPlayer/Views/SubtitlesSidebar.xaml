<UserControl x:Class="LLPlayer.Views.SubtitlesSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LLPlayer.Controls"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             xmlns:mediaStream="clr-namespace:FlyleafLib.MediaFramework.MediaStream;assembly=FlyleafLib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SubtitlesSidebarVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.InputBindings>
        <!-- Shortcut for when the sidebar has focus (not configurable) -->
        <KeyBinding
            Modifiers="Ctrl"
            Key="F"
            Command="{Binding FL.Action.CmdActivateSubsSearch}" />
        <KeyBinding
            Key="Esc"
            Command="{Binding CmdClearSearch}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                        <Setter Property="Width" Value="24" />
                        <Setter Property="Height" Value="24" />
                        <Setter Property="Margin" Value="6 0 6 0" />
                        <Setter Property="Background" Value="#01000000" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                    </Style>

                    <Style x:Key="ToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignActionToggleButton}">
                        <Setter Property="Width" Value="24" />
                        <Setter Property="Height" Value="24" />
                        <Setter Property="Margin" Value="6 0 6 0" />
                        <Setter Property="Background" Value="#01000000" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                    </Style>

                    <Style x:Key="SubIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                        <Setter Property="Width" Value="20" />
                        <Setter Property="Height" Value="20" />
                        <Setter Property="Margin" Value="0 0 4 0" />
                        <!-- Focusable so per-row actions can take keyboard focus (the list stays non-selectable;
                             with the ListBox default TabNavigation=Once, Tab reaches the first row's action — full
                             per-row arrow-key navigation is a separate pass). Visible-but-dim at rest (>=0.6 for
                             UI-icon contrast) so the actions are discoverable; brighten on hover OR keyboard focus. -->
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                        <Setter Property="Opacity" Value="0.6" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                <Setter Property="Opacity" Value="1.0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                <Setter Property="Opacity" Value="1.0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="SubPlayIconButton" TargetType="Button" BasedOn="{StaticResource SubIconButton}">
                        <Setter Property="ToolTipService.Placement" Value="Left" />
                        <Setter Property="ToolTipService.HorizontalOffset" Value="-10" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.FL.Config.SidebarLeft, ElementName=SubtitleListBox}" Value="True">
                                <Setter Property="ToolTipService.Placement" Value="Right" />
                                <Setter Property="ToolTipService.HorizontalOffset" Value="10" />
                            </DataTrigger>

                            <!-- Activate if MouseOver -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            </Trigger>

                            <!-- Same Primary accent on keyboard focus as on hover (overrides the base Secondary focus colour). -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            </Trigger>

                            <!-- Activate if playing -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource SubIsPlayingConv}">
                                        <Binding Path="Index" />
                                        <Binding ElementName="SubtitleListBox"
                                                 Path="DataContext.SubManager.CurrentIndex" />
                                        <Binding ElementName="SubtitleListBox"
                                                 Path="DataContext.SubManager.IsDisplaying" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <!-- Full opacity for the currently-playing row even without hover (base rests at 0.6). -->
                                <Setter Property="Opacity" Value="1.0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PopupBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource MaterialDesignToolBarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Search Bar -->
            <RowDefinition Height="*" />    <!-- Main Content (ListBox) -->
            <RowDefinition Height="Auto" /> <!-- Spinner/ProgressBar -->
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Margin="7">

            <!-- Primary Secondary Toggle -->
            <ToggleButton
                Style="{StaticResource ToggleButton}"
                materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=Numeric2BoxMultipleOutline}"
                Content="{materialDesign:PackIcon Kind=Numeric1BoxMultipleOutline}"
                ToolTip="Toggle Primary / Secondary"
                AutomationProperties.Name="Toggle Primary / Secondary subtitles"
                Command="{Binding FL.Action.CmdToggleSidebarShowSecondary}"
                IsChecked="{Binding FL.Config.SidebarShowSecondary, Mode=OneWay}" />

            <!-- Subtitle Tracks quick switcher: one place that lists every available track (embedded in the
                 video, external files found beside it / downloaded, and ASR) with its language + source, and
                 assigns it to slot ① primary or ② secondary in a single click. Mirrors the right-click
                 Subtitles ▸ Subtitle Tracks menu but stays open for fast switching. -->
            <materialDesign:PopupBox
                Margin="6 0"
                Width="20"
                Height="20"
                Background="{x:Null}"
                StaysOpen="True"
                PlacementMode="BottomAndAlignCentres"
                ToolTip="Subtitle tracks — switch primary / secondary"
                AutomationProperties.Name="Subtitle tracks switcher"
                ToolTipService.Placement="Right">
                <materialDesign:PopupBox.ToggleContent>
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource MaterialDesignBody}"
                        Kind="FormatListBulletedType" />
                </materialDesign:PopupBox.ToggleContent>

                <Border Background="{DynamicResource MaterialDesignPaper}" Padding="10" MaxWidth="460" MinWidth="300">
                    <StackPanel>
                        <DockPanel Margin="0 0 0 6">
                            <TextBlock Text="Subtitle tracks" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Text="① primary   ② secondary" />
                        </DockPanel>

                        <!-- Embedded (in the video container) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FL.Player.Subtitles.Streams.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="In video (embedded)" FontSize="11" Margin="0 2"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <ItemsControl ItemsSource="{Binding FL.Player.Subtitles.Streams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="MovieOpenOutline"
                                                                     Width="16" Height="16" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Grid.Column="1" Margin="6 0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding DisplayMember}" />
                                            <ToggleButton Grid.Column="2" Style="{StaticResource ToggleButton}" Tag="0"
                                                          Content="1" ToolTip="Set as primary (1st)"
                                                          AutomationProperties.Name="Set as primary subtitle"
                                                          IsChecked="{Binding EnabledPrimarySubtitle, Mode=OneWay}"
                                                          Command="{Binding DataContext.FL.Player.Commands.OpenSubtitles, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <ToggleButton.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource Tuple3Conv}">
                                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                                        <Binding Path="." />
                                                        <Binding Source="{x:Static mediaStream:SelectSubMethod.Original}" />
                                                    </MultiBinding>
                                                </ToggleButton.CommandParameter>
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="3" Style="{StaticResource ToggleButton}" Tag="1"
                                                          Content="2" ToolTip="Set as secondary (2nd)"
                                                          AutomationProperties.Name="Set as secondary subtitle"
                                                          IsChecked="{Binding EnabledSecondarySubtitle, Mode=OneWay}"
                                                          Command="{Binding DataContext.FL.Player.Commands.OpenSubtitles, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <ToggleButton.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource Tuple3Conv}">
                                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                                        <Binding Path="." />
                                                        <Binding Source="{x:Static mediaStream:SelectSubMethod.Original}" />
                                                    </MultiBinding>
                                                </ToggleButton.CommandParameter>
                                            </ToggleButton>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- External: subtitle files auto-detected beside the video or downloaded -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FL.Player.Playlist.Selected.ExternalSubtitlesStreamsAll.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Files (beside video / downloaded)" FontSize="11" Margin="0 6 0 2"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <ItemsControl ItemsSource="{Binding FL.Player.Playlist.Selected.ExternalSubtitlesStreamsAll}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="FileDocumentOutline"
                                                                     Width="16" Height="16" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Grid.Column="1" Margin="6 0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding DisplayMember}" />
                                            <ToggleButton Grid.Column="2" Style="{StaticResource ToggleButton}" Tag="0"
                                                          Content="1" ToolTip="Set as primary (1st)"
                                                          AutomationProperties.Name="Set as primary subtitle"
                                                          IsChecked="{Binding EnabledPrimarySubtitle, Mode=OneWay}"
                                                          Command="{Binding DataContext.FL.Player.Commands.OpenSubtitles, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <ToggleButton.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource Tuple3Conv}">
                                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                                        <Binding Path="." />
                                                        <Binding Source="{x:Static mediaStream:SelectSubMethod.Original}" />
                                                    </MultiBinding>
                                                </ToggleButton.CommandParameter>
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="3" Style="{StaticResource ToggleButton}" Tag="1"
                                                          Content="2" ToolTip="Set as secondary (2nd)"
                                                          AutomationProperties.Name="Set as secondary subtitle"
                                                          IsChecked="{Binding EnabledSecondarySubtitle, Mode=OneWay}"
                                                          Command="{Binding DataContext.FL.Player.Commands.OpenSubtitles, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <ToggleButton.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource Tuple3Conv}">
                                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                                        <Binding Path="." />
                                                        <Binding Source="{x:Static mediaStream:SelectSubMethod.Original}" />
                                                    </MultiBinding>
                                                </ToggleButton.CommandParameter>
                                            </ToggleButton>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Separator Margin="0 6" />

                        <!-- Speech-to-text (ASR) per slot + clear a slot -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Margin="0 2 2 2"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding FL.Player.Commands.OpenSubtitlesASR}" CommandParameter="0"
                                    ToolTip="Generate primary subtitles with speech-to-text">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Microphone" Margin="0 0 4 0" VerticalAlignment="Center" />
                                    <TextBlock Text="ASR ①" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1" Margin="2 2 0 2"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding FL.Player.Commands.OpenSubtitlesASR}" CommandParameter="1"
                                    ToolTip="Generate secondary subtitles with speech-to-text">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Microphone" Margin="0 0 4 0" VerticalAlignment="Center" />
                                    <TextBlock Text="ASR ②" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" Margin="0 2 2 2"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding FL.Player.Commands.SubtitlesOff}" CommandParameter="0"
                                    ToolTip="Turn off the primary subtitle">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Margin="0 0 4 0" VerticalAlignment="Center" />
                                    <TextBlock Text="Off ①" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="1" Margin="2 2 0 2"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding FL.Player.Commands.SubtitlesOff}" CommandParameter="1"
                                    ToolTip="Turn off the secondary subtitle">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Margin="0 0 4 0" VerticalAlignment="Center" />
                                    <TextBlock Text="Off ②" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </materialDesign:PopupBox>

            <!-- Font Size -->
            <materialDesign:PopupBox
                PlacementMode="BottomAndAlignCentres"
                Margin="6 0"
                Width="20"
                Background="{x:Null}"
                Height="20"
                BorderBrush="{DynamicResource MaterialDesignBody}"
                StaysOpen="True"
                Style="{StaticResource MaterialDesignMultiFloatingActionPopupBox}"
                ToolTip="Change Font Size"
                AutomationProperties.Name="Change Font Size"
                ToolTipService.Placement="Right">
                <materialDesign:PopupBox.ToggleContent>
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource MaterialDesignBody}"
                        Kind="FormatText" />
                </materialDesign:PopupBox.ToggleContent>

                <!--TODO: L: In Toolbar, there is a bug that the color of the button turns black when it overflows.
                I don't know how to solve this problem, so I use StackPanel.-->
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding CmdSubFontSizeChange}"
                            CommandParameter="-1"
                            Background="{DynamicResource MaterialDesignToolBarBackground}"
                            ToolTip="Font size decrease"
                            AutomationProperties.Name="Font size decrease"
                            Content="{materialDesign:PackIcon Kind=FormatFontSizeDecrease}" />

                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding CmdSubFontSizeChange}"
                            CommandParameter="1"
                            Background="{DynamicResource MaterialDesignToolBarBackground}"
                            ToolTip="Font size increase"
                            AutomationProperties.Name="Font size increase"
                            Content="{materialDesign:PackIcon Kind=FormatFontSizeIncrease}" />
                </StackPanel>
            </materialDesign:PopupBox>

            <!-- Prevent Spoiler Toggle -->
            <ToggleButton
                Style="{StaticResource ToggleButton}"
                materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=EyeOffOutline}"
                Content="{materialDesign:PackIcon Kind=EyeOutline}"
                ToolTip="Toggle hiding after current subtitles"
                AutomationProperties.Name="Toggle hiding after current subtitles (spoiler mask)"
                Command="{Binding CmdSubTextMaskToggle}"
                IsChecked="{Binding FL.Config.SidebarTextMask, Mode=OneWay}" />

            <!-- Translation Display Toggle -->
            <ToggleButton
                Style="{StaticResource ToggleButton}"
                materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=TranslateOff}"
                Content="{materialDesign:PackIcon Kind=Translate}"
                ToolTip="Toggle to show original text when translating enabled"
                AutomationProperties.Name="Toggle original / translated text"
                Command="{Binding FL.Action.CmdToggleSidebarShowOriginalText}"
                IsChecked="{Binding FL.Config.SidebarShowOriginalText, Mode=OneWay}" />

            <!-- Subtitles Downloader -->
            <Button Style="{StaticResource IconButton}"
                    Command="{Binding CmdShowDownloadSubsDialog}"
                    ToolTip="Download subtitles"
                    AutomationProperties.Name="Download subtitles"
                    Content="{materialDesign:PackIcon Kind=Download}" />

            <!-- Subtitles Exporter -->
            <Button Style="{StaticResource IconButton}"
                    Command="{Binding CmdShowExportSubsDialog}"
                    ToolTip="Export subtitles as srt"
                    AutomationProperties.Name="Export subtitles as SRT"
                    Content="{materialDesign:PackIcon Kind=FileExportOutline}" />

            <!-- Batch Subtitles -->
            <Button Style="{StaticResource IconButton}"
                    Command="{Binding FL.Action.CmdOpenWindowBatchSubtitles}"
                    ToolTip="Batch ASR and translate subtitles"
                    AutomationProperties.Name="Batch ASR and translate subtitles"
                    Content="{materialDesign:PackIcon Kind=PlaylistPlay}" />

            <!-- Sidebar Left Toggle -->
            <Button Style="{StaticResource IconButton}"
                    Command="{Binding CmdSwapSidebarPosition}"
                    ToolTip="Swap sidebar position"
                    AutomationProperties.Name="Swap sidebar position"
                    Content="{materialDesign:PackIcon Kind=SwapHorizontal}" />

            <!-- Subtitle Search -->
            <Button Style="{StaticResource IconButton}"
                    ToolTip="Search (Ctrl+F)"
                    AutomationProperties.Name="Search subtitles"
                    Command="{Binding FL.Action.CmdActivateSubsSearch}"
                    Content="{materialDesign:PackIcon Kind=Magnify}" />

        </StackPanel>

        <!-- Search Input Row: Shown only when search is active -->
        <Grid Grid.Row="1" Margin="7 0 7 16" Visibility="{Binding FL.Config.SidebarSearchActive, Converter={StaticResource BooleanToVisibilityConv}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                FontSize="14"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Search subtitles..."
                materialDesign:HintAssist.Hint="Search subtitles"
                materialDesign:HintAssist.HelperText="{Binding HitCount}"
                helpers:FocusBehavior.IsFocused="{Binding FL.Config.SidebarSearchActive}">
                <TextBox.InputBindings>
                    <KeyBinding
                        Key="Enter"
                        Command="{Binding CmdNextMatch}" />
                    <KeyBinding
                        Key="Enter"
                        Modifiers="Shift"
                        Command="{Binding CmdPrevMatch}" />
                </TextBox.InputBindings>
            </TextBox>

            <!-- F-14 search option toggles: match case / whole word / regex -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton
                    Style="{StaticResource ToggleButton}"
                    materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=FormatLetterCase}"
                    Content="{materialDesign:PackIcon Kind=FormatLetterCase}"
                    ToolTip="Match case"
                    AutomationProperties.Name="Match case"
                    IsChecked="{Binding FL.Config.SidebarSearchMatchCase}" />
                <ToggleButton
                    Style="{StaticResource ToggleButton}"
                    materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=FormatLetterMatches}"
                    Content="{materialDesign:PackIcon Kind=FormatLetterMatches}"
                    ToolTip="Match whole word"
                    AutomationProperties.Name="Match whole word"
                    IsChecked="{Binding FL.Config.SidebarSearchWholeWord}" />
                <ToggleButton
                    Style="{StaticResource ToggleButton}"
                    materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=Regex}"
                    Content="{materialDesign:PackIcon Kind=Regex}"
                    ToolTip="Use regular expression"
                    AutomationProperties.Name="Use regular expression"
                    IsChecked="{Binding FL.Config.SidebarSearchRegex}" />
            </StackPanel>

            <Button
                Grid.Column="2"
                Style="{StaticResource IconButton}"
                Margin="2 0 0 0"
                ToolTip="Clear search (Esc)"
                AutomationProperties.Name="Clear search"
                Command="{Binding CmdClearSearch}">
                <materialDesign:PackIcon
                    Kind="CloseCircle"
                    Width="18"
                    Height="18" />
            </Button>
        </Grid>

        <controls:NonTopmostPopup
            Grid.Row="0"
            Placement="Relative"
            PlacementTarget="{Binding PopupPlacementTarget, ElementName=WordPopupControl}"
            PopupAnimation="None"
            AllowsTransparency="True"
            HorizontalOffset="{Binding PopupHorizontalOffset, ElementName=WordPopupControl}"
            VerticalOffset="{Binding PopupVerticalOffset, ElementName=WordPopupControl}"
            IsTopmost="{Binding FL.Config.AlwaysOnTop}"
            IsOpen="{Binding IsOpen, ElementName=WordPopupControl}"
            StaysOpen="True">
            <controls:WordPopup
                x:Name="WordPopupControl"
                IsSidebar="True"
                MaxWidth="400" />
        </controls:NonTopmostPopup>

        <ListBox
            x:Name="SubtitleListBox"
            Grid.Row="2"
            FlowDirection="{Binding FL.Config.SidebarFlowDirection}"
            FontSize="{Binding FL.Config.SidebarFontSize}"
            FontFamily="{Binding FL.Config.SidebarFontFamily}"
            FontWeight="{Binding FL.Config.SidebarFontWeight}"
            BorderThickness="0"
            Foreground="{DynamicResource MaterialDesignBody}"
            VirtualizingStackPanel.ScrollUnit="Pixel"
            VirtualizingStackPanel.VirtualizationMode="Recycling"
            VerticalContentAlignment="Top"
            ItemsSource="{Binding SubManager.Subs}"
            SelectedItem="{Binding SubManager.SelectedSub, Mode=OneWay}"
            SelectionChanged="SubtitleListBox_SelectionChanged"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                    <!-- Set to non-selectable list -->
                    <Setter Property="Focusable" Value="False" />
                    <!-- Ensure that the right-most icon is aligned to the far right -->
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="materialDesign:RippleAssist.IsDisabled" Value="True" />
                    <Setter Property="Padding">
                        <Setter.Value>
                            <Binding Path="DataContext.FL.Config.SidebarSubPadding" ElementName="SubtitleListBox" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#444444" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>

            <!-- TODO: L: want to implement a secondary subtitle pop-up (like Language reactor) -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DataTemplate.Resources>
                        <!--Text Subtitles-->
                        <DataTemplate x:Key="SubTextTemplate">
                            <controls:SelectableTextBox
                                TextAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                IsTranslated="{Binding UseTranslated}"
                                SubIndex="{Binding DataContext.SubIndex, ElementName=SubtitleListBox}"
                                WordClicked="SelectableTextBox_OnWordClicked"
                                materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                materialDesign:TextFieldAssist.DecorationVisibility="Hidden">

                                <controls:SelectableTextBox.FlowDirection>
                                    <MultiBinding Converter="{StaticResource SubTextFlowDirectionConv}" Mode="OneWay">
                                        <Binding Path="UseTranslated" />
                                        <Binding Path="DataContext.SubIndex" ElementName="SubtitleListBox" />
                                        <Binding Path="DataContext.FL" ElementName="SubtitleListBox" />
                                    </MultiBinding>
                                </controls:SelectableTextBox.FlowDirection>

                                <controls:SelectableTextBox.Text>
                                    <MultiBinding Converter="{StaticResource SubTextMaskConv}" Mode="OneWay">
                                        <Binding Path="Index" />
                                        <Binding Path="DisplayText" />
                                        <Binding Path="Text" />
                                        <Binding Path="DataContext.SubManager.CurrentIndex" ElementName="SubtitleListBox" />
                                        <Binding Path="DataContext.FL.Config.SidebarTextMask" ElementName="SubtitleListBox" />
                                        <Binding Path="DataContext.FL.Config.SidebarShowOriginalText" ElementName="SubtitleListBox" />
                                    </MultiBinding>
                                </controls:SelectableTextBox.Text>
                            </controls:SelectableTextBox>
                        </DataTemplate>

                        <!-- Bitmap Subtitles -->
                        <DataTemplate x:Key="SubBitmapTemplate">
                            <Image
                                HorizontalAlignment="Left"
                                Stretch="Uniform"
                                StretchDirection="DownOnly"
                                Source="{Binding Converter={StaticResource SubBitmapImageSourceConv}}">
                                <Image.Visibility>
                                    <MultiBinding Converter="{StaticResource ListItemIndexVisibilityConv}" Mode="OneWay">
                                        <Binding Path="Index" />
                                        <Binding Path="SelectedIndex" ElementName="SubtitleListBox" />
                                        <Binding Path="DataContext.FL.Config.SidebarTextMask" ElementName="SubtitleListBox" />
                                    </MultiBinding>
                                </Image.Visibility>
                            </Image>
                        </DataTemplate>
                    </DataTemplate.Resources>

                    <!-- Left-accent border marks the currently-playing cue, reusing the EXACT signal the
                         Play button uses (SubIsPlayingConv). Rows stay non-selectable; no auto-scroll change. -->
                    <Border BorderThickness="3 0 0 0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource SubIsPlayingConv}">
                                                <Binding Path="Index" />
                                                <Binding ElementName="SubtitleListBox" Path="DataContext.SubManager.CurrentIndex" />
                                                <Binding ElementName="SubtitleListBox" Path="DataContext.SubManager.IsDisplaying" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    <Grid Margin="0 5 1 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="PlayButton"
                            Grid.Column="0"
                            AutomationProperties.Name="Play from this subtitle"
                            FlowDirection="LeftToRight"
                            ToolTipService.InitialShowDelay="200"
                            ToolTip="{Binding StartTime, Converter={StaticResource TimeSpanToStringConv}}"
                            Command="{Binding DataContext.CmdSubPlay, ElementName=SubtitleListBox}"
                            CommandParameter="{Binding Index}"
                            materialDesign:RippleAssist.Feedback="Transparent"
                            Style="{StaticResource SubPlayIconButton}"
                        >
                            <materialDesign:PackIcon Kind="Play"
                                Width="20"
                                Height="20" />
                        </Button>

                        <!-- Can use ContentTemplateSelecter?-->
                        <!-- Display text or bitmap -->
                        <ContentControl Grid.Column="1" Content="{Binding}" FlowDirection="LeftToRight">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SubTextTemplate}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsText}" Value="False">
                                            <Setter Property="ContentTemplate" Value="{StaticResource SubBitmapTemplate}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <!-- Sync subtitles -->
                        <Button
                            x:Name="SubSyncButton"
                            Grid.Column="2"
                            AutomationProperties.Name="Sync subtitle to current time"
                            FlowDirection="LeftToRight"
                            ToolTip="Adjust the delay so that this subtitle is currently playing."
                            Command="{Binding DataContext.CmdSubSync, ElementName=SubtitleListBox}"
                            CommandParameter="{Binding Index}"
                            materialDesign:RippleAssist.Feedback="Transparent"
                            Style="{StaticResource SubIconButton}">
                            <materialDesign:PackIcon Kind="Sync"
                                Width="20"
                                Height="20" />
                        </Button>

                        <!-- Assign a per-line dub voice (F-16 phase 2a). Left-click opens a context menu of the
                             GPU-free voice bank (built-in presets + custom ids) plus a "use default voice" entry;
                             the icon lights (Primary, full opacity) when this cue carries an override. Additive —
                             no effect unless the AI dub is generated; the override is interactive/in-memory only.
                             Tag carries the VM so the out-of-tree menu can reach its command + voice list. -->
                        <Button
                            x:Name="SubVoiceButton"
                            Grid.Column="3"
                            AutomationProperties.Name="Assign a dub voice to this subtitle line"
                            FlowDirection="LeftToRight"
                            ToolTip="Assign a dub voice for this line (overrides the default voice in the AI dub)."
                            Tag="{Binding DataContext, ElementName=SubtitleListBox}"
                            Click="SubVoiceButton_OnClick"
                            materialDesign:RippleAssist.Feedback="Transparent">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubIconButton}">
                                    <Style.Triggers>
                                        <!-- This line carries an explicit per-line dub voice: keep it lit even at rest. -->
                                        <DataTrigger Binding="{Binding AssignedVoiceId, Converter={StaticResource StringHasValueConv}}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon Kind="AccountVoice"
                                Width="20"
                                Height="20" />
                            <Button.ContextMenu>
                                <ContextMenu
                                    Style="{StaticResource FlyleafContextMenu}"
                                    ItemsSource="{Binding PlacementTarget.Tag.DubVoiceMenuItems, RelativeSource={RelativeSource Self}}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                            <Setter Property="Header" Value="{Binding DisplayName}" />
                                            <Setter Property="Command" Value="{Binding PlacementTarget.Tag.CmdSubSetVoice, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}" />
                                            <Setter Property="CommandParameter">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource SubVoiceAssignmentConv}">
                                                        <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}" />
                                                        <Binding Path="Id" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Per-cue ASR language badge (T-10 follow-up). Visible only when per-segment language
                             detection is ON and the cue carries a resolvable code: ASR stamps Language on every
                             cue even with the toggle off (mirroring the pinned transcript language), so the gate
                             is what keeps the default UI byte-identical. Loaded/translated cues never set it. -->
                        <TextBlock
                            x:Name="SubLanguageBadge"
                            Grid.Column="4"
                            FlowDirection="LeftToRight"
                            VerticalAlignment="Center"
                            TextAlignment="Center"
                            Margin="4 0 2 0"
                            FontSize="10"
                            MinWidth="18"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            Opacity="0.6"
                            ToolTipService.InitialShowDelay="200"
                            ToolTip="{Binding Language.DisplayName}"
                            Text="{Binding Language, Converter={StaticResource SubLanguageBadgeConv}, Mode=OneWay}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource SubLanguageBadgeVisibilityConv}" Mode="OneWay">
                                    <Binding Path="Language" />
                                    <Binding ElementName="SubtitleListBox" Path="DataContext.FL.PlayerConfig.Subtitles.ASRPerSegmentLanguage" />
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state: no subtitle track loaded / zero cues. Click/scroll-through (IsHitTestVisible=False);
             ANDed with !IsLoading so it never flashes before the spinner during the brief load window. -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsHitTestVisible="False" Margin="16">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SubManager.Subs.Count}" Value="0" />
                                <Condition Binding="{Binding SubManager.IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <materialDesign:PackIcon Kind="SubtitlesOutline" Width="48" Height="48"
                                     HorizontalAlignment="Center" Opacity="0.5"
                                     Foreground="{DynamicResource MaterialDesignBody}" />
            <TextBlock Text="No subtitles" HorizontalAlignment="Center" Margin="0 8 0 0"
                       FontSize="14" Opacity="0.7" Foreground="{DynamicResource MaterialDesignBody}" />
            <TextBlock Text="Pick a subtitle stream or run ASR" HorizontalAlignment="Center"
                       Margin="0 4 0 0" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" />
        </StackPanel>

        <!-- Spinner (when loading subs / OCR / ASR) -->
        <ProgressBar
            Grid.Row="3"
            Margin="10"
            IsIndeterminate="True"
            Style="{StaticResource MaterialDesignCircularProgressBar}"
            ToolTip="Loading..."
            Visibility="{Binding SubManager.IsLoading, Converter={StaticResource BooleanToVisibilityConv}}"
            Width="20"
            Height="20"
            Foreground="#888888" />
    </Grid>
</UserControl>
