<prism:PrismApplication x:Class="LLPlayer.App"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                        xmlns:prism="http://prismlibrary.com/"
                        ShutdownMode="OnMainWindowClose"
                        DispatcherUnhandledException="App_OnDispatcherUnhandledException">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Dark" PrimaryColor="#D23D6F" SecondaryColor="#00B8D4" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />

                <!-- Order is load-bearing: PopupMenu.xaml uses StaticResource keys defined in
                     MaterialDesignMy.xaml + Converters.xaml (and the MDIX defaults above), so it must
                     stay merged after them. Do not reorder. -->
                <ResourceDictionary Source="/Resources/MaterialDesignMy.xaml"/>
                <!-- M3 (Material You) shape + component styles. Non-colour; keyed (opt-in). Must stay
                     after MaterialDesignMy (its styles are BasedOn MDIX defaults) and before Converters. -->
                <ResourceDictionary Source="/Resources/M3.xaml"/>
                <ResourceDictionary Source="/Resources/Converters.xaml"/>
                <ResourceDictionary Source="/Resources/PopupMenu.xaml"/>
                <ResourceDictionary Source="/Resources/Validators.xaml"/>
                <!-- M3 colour overlays — merged LAST so the rose-tinted surface ramp + primary-container
                     accents win over the CustomColorTheme-generated palette at DynamicResource lookup.
                     Toggled at runtime by AppConfigTheme (present only for the dark default + un-customised
                     colours), so Light / Follow-Windows / accent-sync / colour-picker keep working. -->
                <ResourceDictionary Source="/Resources/M3.Surfaces.xaml"/>
                <ResourceDictionary Source="/Resources/M3.Accent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
