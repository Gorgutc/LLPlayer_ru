<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-windows10.0.18362.0;net10.0</TargetFrameworks>
		<!-- The existing WPF release action invokes msbuild /t:Publish with only FolderProfile.
		     Select its TFM before the SDK decides whether this is a cross-targeting build. -->
		<TargetFramework Condition="'$(PublishProfile)' == 'FolderProfile'">net10.0-windows10.0.18362.0</TargetFramework>
		<RuntimeIdentifiers Condition="'$(TargetFramework)' != 'net10.0'">win-x64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0'">win-x64;linux-x64</RuntimeIdentifiers>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AssemblyVersion>1.3.1.0</AssemblyVersion>
		<FileVersion>1.3.1.0</FileVersion>
		<RootNamespace>FlyleafLib.Plugins</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="FlyleafLibTests" />
		<ProjectReference Include="..\..\FlyleafLib\FlyleafLib.csproj">
			<Private>false</Private>
			<ExcludeAssets>All</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(TargetFramework)' == 'net10.0-windows10.0.18362.0'">
		<Exec Command="set plugindir=Plugins.NET10&#xD;&#xA;set pluginname=YoutubeDL&#xD;&#xA;if not exist &quot;$(SolutionDir)\Plugins\bin\%25plugindir%25\%25pluginname%25&quot; mkdir &quot;$(SolutionDir)\Plugins\bin\%25plugindir%25\%25pluginname%25&quot;&#xD;&#xA;move &quot;$(TargetDir)*.dll&quot; &quot;$(SolutionDir)\Plugins\bin\%25plugindir%25\%25pluginname%25\&quot;&#xD;&#xA;copy /Y &quot;$(ProjectDir)Libs\*&quot; &quot;$(SolutionDir)\Plugins\bin\%25plugindir%25\%25pluginname%25\&quot;&#xD;&#xA;del /Q &quot;$(SolutionDir)\Plugins\bin\%25plugindir%25\%25pluginname%25\yt-dlp.exe_here&quot;" />
	</Target>

</Project>
